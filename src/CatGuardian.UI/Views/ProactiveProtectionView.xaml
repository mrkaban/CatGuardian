                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc Pp0205}"/>

                            <!-- Параметры (видны при включённом модуле) -->
                            <StackPanel x:Name="Mod8OptionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
