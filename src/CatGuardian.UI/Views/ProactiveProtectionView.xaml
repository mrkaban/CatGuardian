            <!-- ============ СЕКЦИЯ 4: КОНТРОЛЬ ЗАКРЕПЛЕНИЯ ============ -->
            <TextBlock Style="{StaticResource SectionTitleUpper}"
                       Text="{loc:Loc Pp0323}"
                       Margin="0,18,0,8"/>

            <!-- 3.0.0.7: «Контроль автозагрузки» РЕАЛИЗОВАН (AutoStartMonitor): свитч управляет
                 настройкой MonitorAutoStart, интервал — AutoStartCheckIntervalMinutes, «Проверить сейчас»
                 запускает немедленную проверку через службу. Категории проверки — чекбоксами ниже.
                 3.0.0.41: расширенные точки (папка Startup, StartupApproved, RunServices, Winlogon\Notify,
                 AppInit_DLLs, SSODelayLoad, Active Setup, Policies\Run); Службы/Notify по умолчанию ВЫКЛЮЧЕНЫ. -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <!-- Контроль автозагрузки -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod3AutoStart" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod3State" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0325}"/>
