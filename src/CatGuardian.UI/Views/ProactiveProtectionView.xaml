<UserControl x:Class="CatGuardian.UI.Views.ProactiveProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <!-- Проактивная защита (3.0.0.49): ревизия структуры — 5 логических секций.
         ⚡ Активная защита и поведенческий анализ (процессы, ETW-память, DLL, связи, LOLBins,
         AMSI, HIPS-lite); 📁 Защита файлов (шифровальщики, Pre-Scan, энтропия, песочница);
         🌐 Сетевая защита (эвристика брандмауэра, порты, анти-майнер);
         📦 Контроль закрепления (автозагрузка, ярлыки, WMI, блокировщики);
         🔑 Защита данных и приватности (Anti-Stealer, буфер обмена, камера/микрофон, расширения).
         Внутренние имена элементов Mod1Anomaly*/Mod4Wmi* сохранены исторически и на
         отображение не влияют. -->
    <UserControl.Resources>
        <!-- Свитч-переключатель: зелёный «ВКЛ» / серый «ВЫКЛ», неактивные приглушены. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource BorderBrush}"/>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource GreenBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <!-- 3.0.0.99: подсветка переключателя при наведении указателя —
                                 акцентная рамка трека + тонкое акцентное кольцо бегунка. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,8">

            <!-- Шапка: часть модулей уже реализована, пометка «в разработке» убрана (3.0.0.6). -->
            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Pp0001}"/>
                <TextBlock Text="{loc:Loc Pp0002}"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ============ СЕКЦИЯ 1: АКТИВНАЯ ЗАЩИТА И ПОВЕДЕНЧЕСКИЙ АНАЛИЗ ============ -->
            <TextBlock Style="{StaticResource SectionTitleUpper}"
                       Text="{loc:Loc Pp0003}"
                       Margin="0,4,0,8"/>

            <!-- «Контроль запуска процессов» реализован (ProcessMonitor, 3.0.0.6) — карточка активна.
                 СТАТИЧЕСКАЯ проверка: ловит появление нового процесса, путь → хэш → сигнатурный скан
                 ClamAV. Поведенческий ETW-детект памяти вынесен в ОТДЕЛЬНЫЙ пункт ниже (3.0.0.12). -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <!-- Контроль запуска процессов: кнопка «⚙» убрана (3.0.0.6) — настроек пока нет. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1ProcEtw" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                  Checked="OnProcessMonitorToggled" Unchecked="OnProcessMonitorToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1ProcEtwState" Grid.Column="1" Text="{loc:Loc Pp0004}"
                                   Foreground="{DynamicResource GreenBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0005}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0006}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="Mod1ProcEtwHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{loc:Loc Pp0007}"/>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- ETW-мониторинг памяти (3.0.0.12): РЕАЛИЗОВАН. Отдельный от «Контроля запуска
                         процессов» пункт — ДИНАМИЧЕСКАЯ эвристика поведения внутри памяти. Свитч управляет
                         EtwBehaviorEnabled; по умолчанию ВЫКЛЮЧЕН (нулевая нагрузка — TraceEventSession
                         не создаётся). Параметры: авто-Kill, доверие подписям MS, маскарад/RWX/LSASS,
                         кулдаун. Сохраняются сразу и применяются службой через ReloadConfig. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1Etw" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnEtwToggled" Unchecked="OnEtwToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1EtwState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0009}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0010}"/>
                            <StackPanel x:Name="Mod1EtwPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1EtwKill" Content="{loc:Loc Pp0011}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0012}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                    <CheckBox x:Name="Mod1EtwTrustMs" Content="{loc:Loc Pp0013}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0014}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                    <CheckBox x:Name="Mod1EtwRequireUnsigned" Content="{loc:Loc Pp0015}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0016}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1EtwMasquerade" Content="{loc:Loc Pp0017}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0018}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                    <CheckBox x:Name="Mod1EtwRwx" Content="{loc:Loc Pp0019}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0020}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                    <CheckBox x:Name="Mod1EtwLsass" Content="{loc:Loc Pp0021}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0022}"
                                              Checked="OnEtwOptionChanged" Unchecked="OnEtwOptionChanged"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0023}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod1EtwCooldown" Width="140" Margin="8,0,0,0"
                                              SelectionChanged="OnEtwCooldownChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0024}" Tag="10"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0025}" Tag="30"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0026}" Tag="60"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0027}" Tag="120"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="Mod1EtwHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0028}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Контроль DLL-инъекций (3.0.0.29): РЕАЛИЗОВАН. Свитч управляет DllHijackEnabled;
                         по умолчанию ВЫКЛЮЧЕН (нулевая нагрузка — модуль не создаёт очередь/таймеры/подписку).
                         Детект ImageLoad единой сессии ядра ETW: DLL-хыджекинг в системные хосты +
                         Fileless/Reflective-инъекции. Реакция: заморозка NtSuspendProcess → вердикт панели
                         (Kill/Resume); Watchdog по таймауту размораживает процесс (fail-safe). -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1Dll" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnDllToggled" Unchecked="OnDllToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1DllState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0030}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0031}"/>
                            <StackPanel x:Name="Mod1DllPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1DllHijack" Content="{loc:Loc Pp0032}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0033}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                    <CheckBox x:Name="Mod1DllFileless" Content="{loc:Loc Pp0034}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0035}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                    <CheckBox x:Name="Mod1DllSuspend" Content="{loc:Loc Pp0036}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0037}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1DllTrustSigned" Content="{loc:Loc Pp0038}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0039}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                    <!-- 3.0.0.65 (инцидент B): иммунитет по расположению Program Files/Common Files —
                                         установка туда требует прав администратора; убирает ложные сработки на
                                         легитимные библиотеки без подписи (MPC-BE и аналоги). -->
                                    <CheckBox x:Name="Mod1DllTrustProgramFiles" Content="{loc:Loc Pp0040}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0041}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                    <CheckBox x:Name="Mod1DllAutoKillFileless" Content="{loc:Loc Pp0042}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0043}"
                                              Checked="OnDllOptionChanged" Unchecked="OnDllOptionChanged"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Watchdog:" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod1DllWatchdog" Width="110" Margin="8,0,0,0"
                                              SelectionChanged="OnDllWatchdogChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0044}" Tag="3"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0045}" Tag="5"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0024}" Tag="10"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0025}" Tag="30"/>
                                    </ComboBox>
                                    <TextBlock Text="{loc:Loc Pp0048}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <ComboBox x:Name="Mod1DllWatchdogAction" Width="170" Margin="8,0,0,0"
                                              SelectionChanged="OnDllWatchdogActionChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0049}" Tag="0"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0050}" Tag="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0051}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod1DllTrustedPaths" Width="420" Margin="8,0,0,0"
                                             FontSize="12" VerticalContentAlignment="Center"
                                             TextChanged="OnDllTrustedPathsChanged"/>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать». -->
                                <Button x:Name="BtnExclDll" Content="{loc:Loc Pp0052}"
                                        Tag="DllHijackTrustedDllPaths"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0053}"/>
                                <TextBlock x:Name="Mod1DllHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0054}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Аномальные родительские связи (3.0.0.37+, Process Spoofing Audit): РЕАЛИЗОВАН.
                         Свитч управляет ParentChildEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — модуль не создаётся, ETW-подписка не открывается).
                         Событийный анализ пар «родитель → ребёнок» из ETW ProcessStart:
                         системный родитель (svchost/winlogon/lsass/wininit/services/csrss/smss)
                         → шелл (cmd/powershell/wscript/mshta/…) — High; office-приложение → шелл —
                         Medium; explorer → шелл с подозрительной командой; сторонний/неизвестный
                         родитель → шелл с подозрительной командой. Не дублирует М4 (персистентность)
                         и LOLBins (командная строка) — это слой мгновенных связей запуска.
                         Защита легитимного ПО (антивирусы, отечественные программы): доверенные
                         издатели родителей и доверенные пути; авто-kill только для High. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod4ParentChild" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnParentChildToggled" Unchecked="OnParentChildToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod4ParentChildState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Pp0056}"
                                       ToolTip="{loc:Loc Pp0057}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0058}"/>
                            <StackPanel x:Name="Mod4ParentChildPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{loc:Loc Pp0059}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod4ParentChildSensitivity" Width="130" Margin="8,0,0,0"
                                              SelectionChanged="OnParentChildOptionChanged"
                                              ToolTip="{loc:Loc Pp0060}">
                                        <ComboBoxItem Content="{loc:Loc Pp0061}" Tag="0"/>
                                        <ComboBoxItem Content="High + Medium" Tag="1"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0062}" Tag="2"/>
                                    </ComboBox>
                                    <CheckBox x:Name="Mod4ParentChildKill" Content="{loc:Loc Pp0063}"
                                              Margin="16,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0064}"
                                              Checked="OnParentChildOptionChanged" Unchecked="OnParentChildOptionChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Loc Pp0065}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod4ParentChildTrustedPaths" Width="320" Margin="8,0,0,0" Padding="4,2"
                                             LostFocus="OnParentChildExtrasChanged"
                                             ToolTip="{loc:Loc Pp0066}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Loc Pp0067}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod4ParentChildTrustedPublishers" Width="320" Margin="8,0,0,0" Padding="4,2"
                                             LostFocus="OnParentChildExtrasChanged"
                                             ToolTip="{loc:Loc Pp0068}"/>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать». -->
                                <Button x:Name="BtnExclParentChild" Content="{loc:Loc Pp0052}"
                                        Tag="ParentChildTrustedParents"
                                        Margin="0,10,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0070}"/>
                            </StackPanel>
                            <TextBlock x:Name="Mod4ParentChildHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc Pp0071}"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Контроль системных утилит (LOLBins Monitor) (3.0.0.33+, Living-off-the-land): РЕАЛИЗОВАН.
                         Свитч управляет LolBinEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — модуль не создаётся, ETW-подписка не открывается).
                         Событийный анализ командной строки НОВЫХ процессов из 11 известных
                         утилит: powershell -enc/-e, mshta (URL/vbscript), wmic process call
                         create, regsvr32 /s /i, rundll32 (javascript:/MiniDump), certutil
                         -urlcache, bitsadmin /transfer, msiexec /q + remote URL, forfiles /c,
                         schtasks /create. Не дублирует AMSI (контент скрипта) и анти-майнер
                         (пулы/бинарники) — это слой командной строки процесса. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod4LolBin" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnLolBinToggled" Unchecked="OnLolBinToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod4LolBinState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Pp0073}"
                                       ToolTip="{loc:Loc Pp0074}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0075}"/>
                            <StackPanel x:Name="Mod4LolBinPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock Text="{loc:Loc Pp0059}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod4LolBinSensitivity" Width="130" Margin="8,0,0,0"
                                              SelectionChanged="OnLolBinOptionChanged"
                                              ToolTip="{loc:Loc Pp0077}">
                                        <ComboBoxItem Content="{loc:Loc Pp0061}" Tag="0"/>
                                        <ComboBoxItem Content="High + Medium" Tag="1"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0062}" Tag="2"/>
                                    </ComboBox>
                                    <CheckBox x:Name="Mod4LolBinKill" Content="{loc:Loc Pp0063}"
                                              Margin="16,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0081}"
                                              Checked="OnLolBinOptionChanged" Unchecked="OnLolBinOptionChanged"/>
                                    <CheckBox x:Name="Mod4LolBinTrustSystem" Content="{loc:Loc Pp0082}"
                                              Margin="16,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0083}"
                                              Checked="OnLolBinOptionChanged" Unchecked="OnLolBinOptionChanged"/>
                                </StackPanel>
