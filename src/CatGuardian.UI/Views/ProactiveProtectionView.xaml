                                          VerticalAlignment="Center"
                                          ToolTip="{loc:Loc Pp0343}"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatActiveSetup" Content="Active Setup" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatPolicyRun" Content="Policies\Run" Margin="0,2,0,2"
                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                            </WrapPanel>
                            <!-- Панель прогресса снятия эталона реестра (видна во время подготовки). -->
                            <StackPanel x:Name="Mod3SnapshotPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="Mod3SnapshotElapsed" Foreground="{DynamicResource AmberBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Text="{loc:Loc Pp0344}"/>
                                <ProgressBar x:Name="Mod3SnapshotProgress" Height="6" Margin="0,6,0,0" Minimum="0"/>
                                <TextBlock x:Name="Mod3SnapshotBranch" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
