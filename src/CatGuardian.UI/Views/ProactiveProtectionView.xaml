                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Быстрый анализ энтропии (Fast Entropy), 3.0.0.11. РЕАЛИЗОВАН.
                         Свитч управляет EntropyMonitorEnabled; по умолчанию ВЫКЛЮЧЕН (нулевая нагрузка).
                         Параметры: наблюдаемые папки, расширения, макс. размер МБ, порог энтропии,
                         «только уведомлять», «пропускать подписанные ОС». Сохраняются сразу и
