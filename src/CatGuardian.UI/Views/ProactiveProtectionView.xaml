                                    <CheckBox x:Name="Mod1RansomHoneyDesktop" Content="{loc:Loc Pp0144}"
                                              Margin="0,2,12,2" VerticalAlignment="Center"
                                              Checked="OnRansomOptionChanged" Unchecked="OnRansomOptionChanged"/>
                                    <CheckBox x:Name="Mod1RansomHoneyDocuments" Content="{loc:Loc Pp0145}"
