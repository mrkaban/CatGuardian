                                    <CheckBox x:Name="Mod1AntiMinerFirewall" Content="{loc:Loc Pp0310}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0294}"
                                              Checked="OnAntiMinerOptionChanged" Unchecked="OnAntiMinerOptionChanged"/>
                                    <CheckBox x:Name="Mod1AntiMinerTrustSigned" Content="{loc:Loc Pp0312}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0313}"
