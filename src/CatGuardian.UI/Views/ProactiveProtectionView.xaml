                                              SelectedValuePath="Tag"
                                              SelectionChanged="OnSandboxNetworkModeChanged"
                                              ToolTip="{loc:Loc Pp0210}">
                                        <ComboBoxItem Tag="block" Content="{loc:Loc Pp0211}"/>
                                        <ComboBoxItem Tag="loopback" Content="{loc:Loc Pp0212}"/>
                                        <ComboBoxItem Tag="internet" Content="{loc:Loc Pp0213}"/>
                                        <ComboBoxItem Tag="private" Content="{loc:Loc Pp0214}"/>
                                    </ComboBox>
                                    <CheckBox x:Name="Mod8AllowLoopback" Content="{loc:Loc Pp0215}"
                                              Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                              Checked="OnSandboxOptionChanged" Unchecked="OnSandboxOptionChanged"
                                              ToolTip="{loc:Loc Pp0216}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0217}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod8MemoryLimit" Width="60" Margin="8,0,0,0" Text="1024"
                                             TextChanged="OnSandboxOptionChanged"/>
                                    <TextBlock Text="{loc:Loc Pp0218}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"
                                               ToolTip="{loc:Loc Pp0219}"/>
                                    <TextBox x:Name="Mod8ProcessLimit" Width="56" Margin="8,0,0,0" Text="5"
                                             TextAlignment="Center" MaxLength="3"
                                             TextChanged="OnSandboxOptionChanged"/>
                                    <TextBlock Text="{loc:Loc Pp0220}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"
                                               ToolTip="{loc:Loc Pp0221}"/>
                                    <TextBox x:Name="Mod8MaxSessions" Width="56" Margin="8,0,0,0" Text="3"
                                             TextAlignment="Center" MaxLength="3"
                                             TextChanged="OnSandboxOptionChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="Mod8HardZones" Content="{loc:Loc Pp0222}"
                                              VerticalAlignment="Center" IsChecked="False"
                                              Checked="OnSandboxOptionChanged" Unchecked="OnSandboxOptionChanged"
                                              ToolTip="{loc:Loc Pp0223}"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0224}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    <TextBox x:Name="Mod8ProtectedZones" Margin="0,4,0,0" Height="48"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             TextChanged="OnSandboxOptionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0225}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    <TextBox x:Name="Mod8TrustedPaths" Margin="0,4,0,0" Height="40"
