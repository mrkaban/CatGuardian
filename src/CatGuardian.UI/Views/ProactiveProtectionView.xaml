                                    <CheckBox x:Name="Mod1AnomalyMemory" Content="{loc:Loc Pp0113}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0114}"
                                              Checked="OnAnomalyOptionChanged" Unchecked="OnAnomalyOptionChanged"/>
