                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatWinlogonNotify" Content="Winlogon\Notify" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          ToolTip="{loc:Loc Pp0341}"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
