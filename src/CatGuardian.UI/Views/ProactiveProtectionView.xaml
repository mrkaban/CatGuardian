                                <Button x:Name="BtnExclSandbox" Content="{loc:Loc Pp0052}"
                                        Tag="SandboxTrustedPaths"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0227}"/>
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="Mod8ManualLaunchBtn" Content="{loc:Loc Pp0228}"
                                            MinHeight="30" Padding="12,5" HorizontalAlignment="Left"
                                            Click="OnSandboxManualLaunchClick"
                                            ToolTip="{loc:Loc Pp0229}"/>
                                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="{loc:Loc Pp0230}"/>
