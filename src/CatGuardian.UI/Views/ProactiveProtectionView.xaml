                </StackPanel>
            </Border>

            <!-- ============ СЕКЦИЯ 3: СЕТЕВАЯ ЗАЩИТА ============ -->
            <TextBlock Style="{StaticResource SectionTitleUpper}"
                       Text="{loc:Loc Pp0236}"
                       Margin="0,18,0,8"/>

            <!-- Сетевая эвристика и контроль правил Брандмауэра (3.0.0.14): РЕАЛИЗОВАНА.
                 Свитч управляет FirewallHeuristicEnabled; по умолчанию ВЫКЛЮЧЕНА (нулевая
                 нагрузка — таймер опроса TCP-таблицы и EventLogWatcher не создаются).
                 Детект сканеров портов/брутфорса по GetExtendedTcpTable (owner PID):
                 процесс, открывший за окно анализа >= порога уникальных удалённых
                 адресов:портов, — сканер: алерт + авто-Kill. Контроль правил через
                 Журнал событий (Event ID 2004): правило для неподписанного файла
                 удаляется (CatGuardian.Privileged, разовый UAC), файл изолируется
                 (.bak). Перенесён из Модуля 2 в Модуль 1 при ревизии структуры
                 3.0.0.24 (динамический сетевой анализ, а не статическая эвристика).
                 Параметры сохраняются сразу и применяются службой через ReloadConfig. -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod2Firewall" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnFirewallToggled" Unchecked="OnFirewallToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod2FirewallState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0238}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0239}"/>
                            <StackPanel x:Name="Mod2FirewallPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                        <TextBlock Text="{loc:Loc Pp0240}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod2FirewallThreshold" Width="70" Margin="8,0,0,0"
                                                  ToolTip="{loc:Loc Pp0241}"
                                                  SelectionChanged="OnFirewallOptionChanged">
                                            <ComboBoxItem Content="20" Tag="20"/>
                                            <ComboBoxItem Content="30" Tag="30"/>
                                            <ComboBoxItem Content="50" Tag="50"/>
                                            <ComboBoxItem Content="100" Tag="100"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                        <TextBlock Text="{loc:Loc Pp0242}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod2FirewallWindow" Width="80" Margin="8,0,0,0"
                                                  ToolTip="{loc:Loc Pp0243}"
                                                  SelectionChanged="OnFirewallOptionChanged">
                                            <ComboBoxItem Content="{loc:Loc Pp0044}" Tag="3"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0045}" Tag="5"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0024}" Tag="10"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0025}" Tag="30"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="{loc:Loc Pp0248}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod2FirewallPoll" Width="90" Margin="8,0,0,0"
                                                  ToolTip="{loc:Loc Pp0249}"
                                                  SelectionChanged="OnFirewallOptionChanged">
                                            <ComboBoxItem Content="{loc:Loc Pp0250}" Tag="500"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0251}" Tag="1000"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0252}" Tag="2000"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{loc:Loc Pp0253}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod2FirewallUdpThreshold" Width="70" Margin="8,0,0,0"
                                                  ToolTip="{loc:Loc Pp0254}"
                                                  SelectionChanged="OnFirewallOptionChanged">
                                            <ComboBoxItem Content="30" Tag="30"/>
                                            <ComboBoxItem Content="50" Tag="50"/>
                                            <ComboBoxItem Content="100" Tag="100"/>
                                            <ComboBoxItem Content="150" Tag="150"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod2FirewallKill" Content="{loc:Loc Pp0255}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0256}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                    <CheckBox x:Name="Mod2FirewallTrustMs" Content="{loc:Loc Pp0013}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0258}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                    <CheckBox x:Name="Mod2FirewallTrustPf" Content="{loc:Loc Pp0259}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0260}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                    <CheckBox x:Name="Mod2FirewallUdp" Content="{loc:Loc Pp0261}"
                                              Margin="16,2,0,0" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0262}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                </WrapPanel>
                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Loc Pp0263}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Mod2FirewallRuleGuard" Content="{loc:Loc Pp0264}"
                                              Margin="10,0,0,0" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0265}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod2FirewallRuleRemove" Content="{loc:Loc Pp0266}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0267}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                    <CheckBox x:Name="Mod2FirewallRuleIsolate" Content="{loc:Loc Pp0268}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0269}"
                                              Checked="OnFirewallOptionChanged" Unchecked="OnFirewallOptionChanged"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0270}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod2FirewallRuleNames" Width="280" Margin="8,0,0,0" Padding="4,2"
                                             LostFocus="OnFirewallOptionChanged"
                                             ToolTip="{loc:Loc Pp0271}"/>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать».
                                     Два источника: доверенные пути сканера и доверенные имена правил брандмауэра. -->
                                <Button x:Name="BtnExclFirewall" Content="{loc:Loc Pp0052}"
                                        Tag="FirewallScanTrustedPaths;FirewallRuleTrustedNames"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0273}"/>
                                <TextBlock x:Name="Mod2FirewallHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0274}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Детектор слушающих портов (3.0.0.31): РЕАЛИЗОВАН.
                         Свитч управляет PortListenerEnabled; по умолчанию ВЫКЛЮЧЕН (нулевая
                         нагрузка — таймер опроса TCP-таблицы не создаётся). Матрица эвристики:
                         TCP LISTEN на 0.0.0.0 + путь в каталогах риска (Downloads/Desktop/Temp)
                         + нет таблицы сертификатов/недоверенная подпись + не системный процесс
                         → заморозка NtSuspendProcess → алерт панели («Завершить»/«Доверять»),
                         авто-возобновление по таймауту. Параметры сохраняются сразу и
                         применяются службой через ReloadConfig. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
