                                                            <TextBlock FontWeight="Bold" FontSize="12"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       Text="{Binding ExePath}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                                                       Text="{Binding RootPid, StringFormat=PID {0}}" />
                                                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                                                       Text="{Binding StartedUtc, StringFormat=Запущено: {0:dd.MM.yyyy HH:mm:ss}}"/>
                                                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="IL {0} | Сеть: {1} | Зоны: {2}">
                                                                        <Binding Path="IntegrityLevel"/>
                                                                        <Binding Path="NetworkText"/>
                                                                        <Binding Path="ZonesMode"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{loc:Loc Pp0232}" MinHeight="28" Padding="10,4"
                                                                    Margin="4,0,0,0" Tag="{Binding SessionId}"
                                                                    Click="OnSandboxTerminateClick"
                                                                    ToolTip="{loc:Loc Pp0233}"/>
                                                            <Button Content="{loc:Loc Pp0234}" MinHeight="28" Padding="10,4"
                                                                    Margin="4,0,0,0" Tag="{Binding SessionId}"
                                                                    Click="OnSandboxRelaunchClick"
                                                                    ToolTip="{loc:Loc Pp0235}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
