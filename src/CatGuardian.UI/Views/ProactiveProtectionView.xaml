                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatServices" Content="{loc:Loc Pp0335}" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          ToolTip="{loc:Loc Pp0336}"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatTasks" Content="{loc:Loc Pp0337}" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
