                                          SelectionChanged="OnAutoStartIntervalChanged">
                                    <ComboBoxItem Content="{loc:Loc Pp0328}" Tag="5"/>
                                    <ComboBoxItem Content="{loc:Loc Pp0329}" Tag="15"/>
                                    <ComboBoxItem Content="{loc:Loc Pp0330}" Tag="30"/>
                                    <ComboBoxItem Content="{loc:Loc Pp0331}" Tag="60"/>
                                </ComboBox>
                                <Button x:Name="Mod3CheckNow" Content="{loc:Loc Pp0332}" Margin="12,0,0,0"
                                        Click="OnCheckAutoStartNow"/>
                            </StackPanel>
                            <!-- 3.0.0.7: какие категории проверять (службы выключены по умолчанию). -->
                            <WrapPanel x:Name="Mod3CategoriesPanel" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{loc:Loc Pp0333}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,2,10,2"/>
                                <CheckBox x:Name="CatRun" Content="{loc:Loc Pp0334}" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
