                                <CheckBox x:Name="CatStartupFolder" Content="{loc:Loc Pp0338}" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          ToolTip="{loc:Loc Pp0339}"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
                                <CheckBox x:Name="CatStartupApproved" Content="StartupApproved" Margin="0,2,12,2"
                                          VerticalAlignment="Center"
                                          ToolTip="{loc:Loc Pp0340}"
                                          Checked="OnAutoStartCategoryChanged" Unchecked="OnAutoStartCategoryChanged"/>
