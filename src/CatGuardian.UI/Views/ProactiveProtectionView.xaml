                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="Mod1RansomKill" Content="{loc:Loc Pp0133}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0134}"
                                              Checked="OnRansomOptionChanged" Unchecked="OnRansomOptionChanged"/>
