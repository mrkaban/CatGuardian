                                           Text="{loc:Loc Pp0200}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Песочница (AppContainer Sandbox) (3.0.0.39): РЕАЛИЗОВАН.
                         Мастер-свитч управляет SandboxExecutionEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — при выключении не создаётся ни ETW-подписки, ни таймеров).
                         Вектор: повторный запуск подозрительного exe (высокий репутационный риск)
                         в изоляции AppContainer: CreateAppContainerProfile + STARTUPINFOEX
                         (EXTENDED_STARTUPINFO_PRESENT), пониженный Integrity Level (Low), сеть
                         управляется capability (без internetClient — ни входящего, ни исходящего),
                         ограничение записи в защищаемые зоны, лимиты памяти/процессов (Job Object) —
                         ПО ЯВНОМУ РЕШЕНИЮ ПОЛЬЗОВАТЕЛЯ.
                         Уникальность: остальные модули только оповещают/убивают; здесь — реальная
                         изоляция привилегий, драйвер не нужен.
                         Оговорка: совместимость программ под AppContainer не гарантирована;
                         откат — «Снять изоляцию» в любой момент. -->
                    <Grid>
