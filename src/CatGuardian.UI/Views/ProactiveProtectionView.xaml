                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- 3.0.0.30: «Инспектор подмены ярлыков» РЕАЛИЗОВАН (ShortcutHijackMonitor): свитч
                         управляет настройкой ShortcutHijackEnabled. Наблюдение .lnk на рабочем столе,
                         общем рабочем столе и в панели задач (Quick Launch); детектируется изменение
                         цели/аргументов относительно эталона. Сайт-ярлыки (.url) и новые ярлыки
                         НЕ алертятся. Работает внутри CatGuardian.Service — новый процесс не создаётся. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod3Shortcut" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnShortcutToggled" Unchecked="OnShortcutToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod3ShortcutState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0347}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0348}"/>
                            <TextBlock x:Name="Mod3ShortcutHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{loc:Loc Pp0349}"/>
                            <!-- Панель прогресса: видна во время добавления рабочего стола в «Инспектор файлов»
                                 и снятия эталона (3.0.0.30). -->
                            <StackPanel x:Name="Mod3ShortcutProgressPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="Mod3ShortcutProgressText" Foreground="{DynamicResource AmberBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Text="{loc:Loc Pp0350}"/>
                                <ProgressBar x:Name="Mod3ShortcutProgress" Height="6" Margin="0,6,0,0" Minimum="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Защита от скрытых обработчиков WMI (WMI Persistence Guard) (3.0.0.13): РЕАЛИЗОВАН. Свитч управляет
                         настройкой WmiSubscriptionEnabled; по умолчанию ВЫКЛЮЧЕН (нулевая нагрузка —
                         таймер опроса root\subscription не создаётся). Параметры: интервал опроса,
                         пропуск системных подписок Microsoft, проверка CommandLineEventConsumer,
                         проверка при каждом сканировании и доверенные имена. При находке пишется
                         событие и алерт с кнопкой «Удалить объект» (удаление через CatGuardian.Privileged
                         с разовым UAC — root\subscription доступен только администраторам). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod4Wmi" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnWmiToggled" Unchecked="OnWmiToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod4WmiState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0352}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0353}"/>
                            <StackPanel x:Name="Mod4WmiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod4WmiSkipMs" Content="{loc:Loc Pp0354}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0355}"
                                              Checked="OnWmiOptionChanged" Unchecked="OnWmiOptionChanged"/>
                                    <CheckBox x:Name="Mod4WmiCmd" Content="{loc:Loc Pp0356}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0357}"
                                              Checked="OnWmiOptionChanged" Unchecked="OnWmiOptionChanged"/>
                                    <!-- 3.0.0.45 (W3): XSL-фильтры — __EventFilter с QueryLanguage=XSL. -->
                                    <CheckBox x:Name="Mod4WmiXsl" Content="{loc:Loc Pp0358}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0359}"
                                              Checked="OnWmiOptionChanged" Unchecked="OnWmiOptionChanged"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0360}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod4WmiInterval" Width="140" Margin="8,0,0,0"
                                              SelectionChanged="OnWmiIntervalChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0105}" Tag="15"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0106}" Tag="30"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0363}" Tag="60"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0364}" Tag="120"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0365}" Tag="360"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0366}" Tag="720"/>
                                    </ComboBox>
                                    <Button Content="{loc:Loc Pp0367}" Margin="12,0,0,0" Padding="10,3"
                                            Click="OnWmiCheckNow"
                                            ToolTip="{loc:Loc Pp0368}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0369}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod4WmiTrustedNames" Width="280" Margin="8,0,0,0" Padding="4,2"
                                             LostFocus="OnWmiTrustedNamesChanged"
                                             ToolTip="{loc:Loc Pp0370}"/>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать». -->
                                <Button x:Name="BtnExclWmi" Content="{loc:Loc Pp0052}"
                                        Tag="WmiTrustedNames"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0372}"/>
                                <TextBlock x:Name="Mod4WmiHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0373}"/>
                                <!-- 3.0.0.45: AMSI-подтверждение находок WMI — жёлтый
                                     предупреждающий баннер (паттерн Mod5AmsiFeatureWarn),
                                     виден ТОЛЬКО при выключенном AMSI; при активном AMSI это
                                     штатный режим — баннер скрыт (зелёных баннеров в карточках
                                     проекта нет). -->
                                <Border x:Name="Mod4WmiAmsiNote" Visibility="Collapsed"
                                        Background="#33FFC107" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                                        ToolTip="{loc:Loc Pp0374}">
                                    <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{loc:Loc Pp0375}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Защита от блокировщиков экрана (Winlock Protection, 3.0.0.20): РЕАЛИЗОВАНА.
                         Свитч управляет WinlockProtectionEnabled; по умолчанию ВЫКЛЮЧЕНА (нулевая
                         нагрузка — фильтр работает только внутри цикла контроля автозагрузки).
                         Превентивная изоляция неподписанного exe из временной папки,
                         закрепившегося в автозагрузке (баннер-блокировщик экрана):
                         переименование .bak + удаление записи. Включение автоматически
                         включает «Контроль автозагрузки». Перенесена из Модуля 1 в Модуль 3
                         при ревизии структуры 3.0.0.24 (работает внутри Persistence Control). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1Winlock" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnWinlockToggled" Unchecked="OnWinlockToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1WinlockState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0377}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0378}"/>
                            <StackPanel x:Name="Mod1WinlockPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1WinlockRename" Content="{loc:Loc Pp0379}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0380}"
                                              Checked="OnWinlockOptionChanged" Unchecked="OnWinlockOptionChanged"/>
                                    <CheckBox x:Name="Mod1WinlockKill" Content="{loc:Loc Pp0381}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0382}"
                                              Checked="OnWinlockOptionChanged" Unchecked="OnWinlockOptionChanged"/>
                                    <!-- 3.0.0.48 (L3): рабочий стол в зонах риска (опция выключена по умолчанию). -->
                                    <CheckBox x:Name="Mod1WinlockDesktop" Content="{loc:Loc Pp0383}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0384}"
                                              Checked="OnWinlockOptionChanged" Unchecked="OnWinlockOptionChanged"/>
                                </WrapPanel>
                                <TextBlock x:Name="Mod1WinlockHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0385}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ СЕКЦИЯ 5: ЗАЩИТА ДАННЫХ И ПРИВАТНОСТИ ============ -->
            <TextBlock Style="{StaticResource SectionTitleUpper}"
                       Text="{loc:Loc Pp0386}"
                       Margin="0,18,0,8"/>

            <!-- Anti-Stealer (3.0.0.16): РЕАЛИЗОВАН. Свитч управляет настройкой
                 AntiStealerEnabled; по умолчанию ВЫКЛЮЧЕН (нулевая нагрузка —
                 таймер и опрос SecurityCenter2 не создаются). Параметры:
                 доверие подписям, пауза между алертами, авто-возобновление.
                 Сохраняются сразу и применяются службой через ReloadConfig. -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1AntiStealer" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnAntiStealerToggled" Unchecked="OnAntiStealerToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1AntiStealerState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0388}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0389}"/>
                            <StackPanel x:Name="Mod1AntiStealerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1AntiStealerTrustSigned" Content="{loc:Loc Pp0390}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0391}"
                                              Checked="OnAntiStealerOptionChanged" Unchecked="OnAntiStealerOptionChanged"/>
                                </WrapPanel>
                                <!-- 3.0.0.27: Блокировка кражи паролей из браузеров (Browser Credential Guard).
                                     Под-свитч Anti-Stealer: наблюдение РЕАЛЬНЫХ хранилищ (Login Data, Local State,
                                     Cookies, logins.json, key4.db) через ту же ETW-сессию. Активен вместе с мастер-свитчем. -->
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1AntiStealerBrowser" Content="{loc:Loc Pp0392}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0393}"
                                              Checked="OnAntiStealerBrowserToggled" Unchecked="OnAntiStealerBrowserToggled"/>
                                    <TextBlock x:Name="Mod1AntiStealerBrowserState" Text="{loc:Loc Pp0008}"
                                               Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <!-- 3.0.0.47: Блокировка кражи системных учётных данных Windows
                                     (System Credential Guard). Под-свитч Anti-Stealer: наблюдение
                                     РЕАЛЬНЫХ хранилищ %*\Microsoft\Credentials и %*\Microsoft\Protect
                                     (DPAPI master keys) через ту же ETW-сессию. Активен вместе
                                     с мастер-свитчем. Vault не отслеживается (системный шум). -->
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1AntiStealerSystemCredential" Content="{loc:Loc Pp0395}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0396}"
                                              Checked="OnAntiStealerSystemToggled" Unchecked="OnAntiStealerSystemToggled"/>
                                    <TextBlock x:Name="Mod1AntiStealerSystemState" Text="{loc:Loc Pp0008}"
                                               Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0023}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod1AntiStealerCooldown" Width="110" Margin="8,0,0,0"
                                              SelectionChanged="OnAntiStealerCooldownChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0024}" Tag="10"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0025}" Tag="30"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0026}" Tag="60"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0027}" Tag="120"/>
                                    </ComboBox>
                                    <TextBlock Text="{loc:Loc Pp0283}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <ComboBox x:Name="Mod1AntiStealerResume" Width="150" Margin="8,0,0,0"
                                              SelectionChanged="OnAntiStealerResumeChanged"
                                              ToolTip="{loc:Loc Pp0404}">
                                        <ComboBoxItem Content="{loc:Loc Pp0285}" Tag="1"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0104}" Tag="5"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0407}" Tag="10"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0106}" Tag="30"/>
                                    </ComboBox>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать». -->
                                <Button x:Name="BtnExclAntiStealer" Content="{loc:Loc Pp0052}"
                                        Tag="antistealer_trusted"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0289}"/>
                                <TextBlock x:Name="Mod1AntiStealerHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0411}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Anti-Spyware (3.0.0.85): детект кейлоггеров и скринкаптеров по таблице
                         импорта PE. Мастер-свитч управляет AntiSpyEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — ETW-подписка не открывается). Двухуровневый вердикт:
                         неподписанный процесс из зон риска (Temp/Downloads/Desktop) или с высоким
                         RiskScore репутации ЗАМОРАЖИВАЕТСЯ; подписанный (Punto Switcher, OBS,
                         Snagit) или вне зон риска — только алерт. Параметры: доверие подписям,
                         пауза между алертами, авто-возобновление, белый/чёрный списки. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1Spyware" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnSpywareToggled" Unchecked="OnSpywareToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1SpywareState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0413}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0414}"/>
                            <StackPanel x:Name="Mod1SpywarePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1SpywareTrustSigned" Content="{loc:Loc Pp0390}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0416}"
                                              Checked="OnSpywareOptionChanged" Unchecked="OnSpywareOptionChanged"/>
                                </WrapPanel>
                                <!-- 3.0.0.85-fix: «Пауза между алертами» и
                                     «Авто-возобновление» расположены ВЕРТИКАЛЬНО (пауза сверху,
                                     возобновление под ней) — в одну строку они не помещались и
                                     выглядели сжато. -->
                                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Pp0023}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod1SpywareCooldown" Width="110" Margin="8,0,0,0"
                                                  SelectionChanged="OnSpywareCooldownChanged">
                                            <ComboBoxItem Content="{loc:Loc Pp0024}" Tag="10"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0025}" Tag="30"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0026}" Tag="60"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0027}" Tag="120"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Loc Pp0283}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod1SpywareResume" Width="150" Margin="8,0,0,0"
                                                  SelectionChanged="OnSpywareResumeChanged"
                                                  ToolTip="{loc:Loc Pp0423}">
                                            <ComboBoxItem Content="{loc:Loc Pp0285}" Tag="1"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0104}" Tag="5"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0407}" Tag="10"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0106}" Tag="30"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 3.0.0.85-fix: кнопки «Чёрный список» и
                                     «Исключения» — вертикально друг над другом СПРАВА, как в
                                     Privacy Shield (эталон). Счётчики и доступность — RefreshListButtons. -->
                                <StackPanel Orientation="Vertical" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button x:Name="BtnSpywareBlacklist" Content="{loc:Loc Pp0428}" Margin="0,0,0,6" Padding="10,3"
                                            HorizontalAlignment="Right" Click="OnSpywareBlacklistClick" IsEnabled="False"
                                            ToolTip="{loc:Loc Pp0429}"/>
                                    <Button x:Name="BtnExclSpyware" Content="{loc:Loc Pp0052}" Padding="10,3"
                                            HorizontalAlignment="Right" Tag="antispy_trusted"
                                            Click="OnModuleExclusionsClick" IsEnabled="False"
                                            ToolTip="{loc:Loc Pp0289}"/>
                                </StackPanel>
                                <TextBlock x:Name="Mod1SpywareHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0432}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- 3.0.0.85-fix: модуль ScreenGuard УДАЛЁН целиком (решение пользователя).
                         Он защищал только окна алертов Cat Guardian (WDA_EXCLUDEFROMCAPTURE),
                         а скринкаптер снимает весь экран — защиту пользователя модуль не
                         обеспечивал. Реальная защита от скринкаптеров остаётся за
                         Anti-Spyware (детект BitBlt/PrintWindow + заморозка процесса). -->

                    <!-- Защита буфера обмена (3.0.0.26, Crypto Clipper Protection): РЕАЛИЗОВАН.
                         ЭКСПЕРИМЕНТАЛЬНЫЙ. Мастер-свитч управляет ClipboardProtectionEnabled; по
                         умолчанию ВЫКЛЮЧЕН (нулевая нагрузка — message-only окно и поток не создаются).
                         Вектор: стилеры читают буфер обмена (пароли, 2FA-коды). Модуль пассивно
                         сверяет содержимое буфера с чувствительными паттернами и предупреждает
                         панель; очистка буфера — ТОЛЬКО по кнопке пользователя. Честные ограничения:
                         без системного hook нельзя достоверно отличить фоновое чтение от легитимного;
                         детект паролей/seed-фраз эвристический — возможны ложные срабатывания. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod6Clipboard" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnClipboardToggled" Unchecked="OnClipboardToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod6ClipboardState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Pp0434}"
                                       ToolTip="{loc:Loc Pp0435}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0436}"/>
                            <TextBlock x:Name="Mod6ClipboardHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc Pp0437}"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Контроль доступа к камере и микрофону (Privacy Shield, 3.0.0.66,
                         финальная спецификация, per-app allowlist): РЕАЛИЗОВАН.
                         Свитч управляет настройкой PrivacyShieldEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — таймер службы не создаётся). Глобальный ConsentStore
                         всегда Allow (иначе Windows не пишет записи использования), при ОБРАЩЕНИИ
                         приложения монитор применяет per-app Deny и показывает алерт с выбором:
                         Доверять / Разрешить разово / Запретить / Закрыть. Параметры: устройства,
                         авто-восстановление, уведомления, период поллинга, а также (3.0.0.67)
                         опция PrivacyShieldKillProcess — завершение активного процесса при «Запретить».
                         Сохраняются сразу и применяются службой через ReloadConfig без перезапуска. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod1PrivacyShield" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnPrivacyShieldToggled" Unchecked="OnPrivacyShieldToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod1PrivacyShieldState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Text="{loc:Loc Pp0439}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0440}"/>
                            <StackPanel x:Name="Mod1PrivacyShieldPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <CheckBox x:Name="Mod1PrivacyCamera" Content="{loc:Loc Pp0441}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0442}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <CheckBox x:Name="Mod1PrivacyMicrophone" Content="{loc:Loc Pp0443}"
                                              Margin="0,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0444}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1PrivacyAutoRestore" Content="{loc:Loc Pp0445}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0446}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <CheckBox x:Name="Mod1PrivacyAllUsers" Content="{loc:Loc Pp0447}"
                                              Margin="0,2,16,2" VerticalAlignment="Center" Visibility="Collapsed"
                                              ToolTip="{loc:Loc Pp0448}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <CheckBox x:Name="Mod1PrivacyAlertTamper" Content="{loc:Loc Pp0449}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0450}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <!-- 3.0.0.67 (доработка, энфорсмент v2): заморозка процесса вместо
                                         kill. Автоматическое завершение браузера недопустимо (потеря
                                         вкладок) — завершение ТОЛЬКО кнопкой «Завершить» в алерте
                                         заморозки. Выключено → реестровый Deny + глобальное Deny-окно:
                                         новые обращения блокируются Windows, текущий захват может
                                         продолжаться до остановки приложением (документированное
                                         ограничение платформы). -->
                                    <CheckBox x:Name="Mod1PrivacySuspend" Content="{loc:Loc Pp0451}"
                                              Margin="0,2,0,2" VerticalAlignment="Center" IsChecked="True"
                                              ToolTip="{loc:Loc Pp0452}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <!-- 3.0.0.67 (доработка): «Не контролировать браузеры» — известные
                                         браузеры (Firefox/Chrome/Edge/Brave/Opera/Yandex и др.) получают
                                         свободный доступ к камере и микрофону: без алертов и энфорсмента.
                                         Не отменяет явный запрет конкретного приложения в чёрном списке. -->
                                    <CheckBox x:Name="Mod1PrivacyTrustBrowsers" Content="{loc:Loc Pp0453}"
                                              Margin="16,2,0,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0454}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                </WrapPanel>
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="Mod1PrivacyWatchOnly" Content="{loc:Loc Pp0455}"
                                              Margin="0,2,16,2" VerticalAlignment="Center"
                                              ToolTip="{loc:Loc Pp0456}"
                                              Checked="OnPrivacyShieldOptionChanged" Unchecked="OnPrivacyShieldOptionChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{loc:Loc Pp0457}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="Mod1PrivacyPoll" Width="120" Margin="8,0,0,0"
                                                  SelectionChanged="OnPrivacyShieldPollChanged">
                                            <ComboBoxItem Content="{loc:Loc Pp0251}" Tag="1000"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0252}" Tag="2000"/>
                                            <ComboBoxItem Content="{loc:Loc Pp0045}" Tag="5000"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <!-- 3.0.0.69 (правка расположения): кнопки списков — друг над другом
                                     (вертикально), СПРАВА, как у чёрного списка веб-камеры. Счётчики
                                     и доступность обновляются в RefreshListButtons. -->
                                <StackPanel Orientation="Vertical" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button x:Name="BtnPrivacyBlacklist" Content="{loc:Loc Pp0428}" Margin="0,0,0,6" Padding="10,3"
                                            HorizontalAlignment="Right" Click="OnPrivacyBlacklistClick" IsEnabled="False"
                                            ToolTip="{loc:Loc Pp0462}"/>
                                    <Button x:Name="BtnExclPrivacyShield" Content="{loc:Loc Pp0052}" Padding="10,3"
                                            HorizontalAlignment="Right" Tag="PrivacyShieldAllowedApps"
                                            Click="OnModuleExclusionsClick" IsEnabled="False"
                                            ToolTip="{loc:Loc Pp0464}"/>
                                </StackPanel>
                                <TextBlock x:Name="Mod1PrivacyShieldHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:Loc Pp0465}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>

                    <!-- Защита от расширений-шпионов (Malicious Extension Watchdog) (3.0.0.38): РЕАЛИЗОВАН.
                         Мастер-свитч управляет MaliciousExtensionEnabled; по умолчанию ВЫКЛЮЧЕН
                         (нулевая нагрузка — при выключении не создаётся ни таймера сканирования,
                         ни чтения manifest'ов). Вектор: вредоносные/шпионские расширения браузера
                         (кража данных, кейлоггинг, сайдлоад). Модуль ТОЛЬКО информирует: ничего
                         не замораживает и не отключает. Эталон расширений снимается здесь же
                         (прогресс «Расширение N из M»), каталоги расширений добавляются в
                         наблюдаемые каталоги «Инспектора файлов». -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Mod7Extensions" Style="{StaticResource ToggleSwitch}" IsChecked="False"
                                  Checked="OnExtensionsToggled" Unchecked="OnExtensionsToggled"
                                  VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Mod7ExtensionsState" Grid.Column="1" Text="{loc:Loc Pp0008}"
                                   Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"
                                   FontSize="11" Margin="8,4,0,0"/>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Pp0467}"
                                       ToolTip="{loc:Loc Pp0468}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{loc:Loc Pp0469}"/>
                            <TextBlock x:Name="Mod7ExtensionsHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc Pp0470}"/>

                            <!-- Параметры (видны при включённом модуле) -->
                            <StackPanel x:Name="Mod7OptionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Pp0059}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="Mod7Sens" Width="130" Margin="8,0,0,0"
                                              SelectionChanged="OnExtensionsOptionChanged">
                                        <ComboBoxItem Content="{loc:Loc Pp0472}" Tag="0"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0131}" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="{loc:Loc Pp0132}" Tag="2"/>
                                    </ComboBox>
                                    <CheckBox x:Name="Mod7ShowInfo" Content="{loc:Loc Pp0475}"
                                              Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                              Checked="OnExtensionsOptionChanged" Unchecked="OnExtensionsOptionChanged"/>
                                    <CheckBox x:Name="Mod7Clamav" Content="{loc:Loc Pp0476}"
                                              Margin="20,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                              Checked="OnExtensionsOptionChanged" Unchecked="OnExtensionsOptionChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Loc Pp0477}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Mod7TrustedIds" Width="300" Margin="8,0,0,0"
                                             TextChanged="OnExtensionsOptionChanged"/>
                                </StackPanel>
                                <!-- 3.0.0.69: просмотр белого списка модуля (записи «Доверять»), счётчик, «Убрать». -->
                                <Button x:Name="BtnExclExtensions" Content="{loc:Loc Pp0052}"
                                        Tag="ExtensionWatchdogTrustedIds"
                                        Margin="0,8,0,0" Padding="10,3" HorizontalAlignment="Right"
                                        Click="OnModuleExclusionsClick" IsEnabled="False"
                                        ToolTip="{loc:Loc Pp0479}"/>
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="Mod7BaselineBtn" Content="{loc:Loc Pp0480}"
                                                MinHeight="30" Padding="12,5" Click="OnExtensionsBaselineClick"
                                                ToolTip="{loc:Loc Pp0481}"/>
                                        <Button x:Name="Mod7ScanNowBtn" Content="{loc:Loc Pp0367}"
                                                MinHeight="30" Padding="12,5" Margin="8,0,0,0"
                                                Click="OnExtensionsScanNowClick"
                                                ToolTip="{loc:Loc Pp0483}"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Pp0484}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="Mod7BaselinePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock x:Name="Mod7BaselineLabel" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="Mod7BaselineProgress" Height="6" Margin="0,6,0,0"
                                                 Minimum="0" Maximum="1" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>