                    <!-- Репутационный и статический анализ (Pre-Scan Heuristics), 3.0.0.10.
                         РЕАЛИЗОВАН. Свитч управляет PreScanHeuristicsEnabled; по умолчанию ВЫКЛЮЧЕН.
                         Параметры: порог высокого риска, включаемые факторы (пути/двойное
                         расширение/энтропия/метаданные), мгновенный Kill высокорисковых процессов,
                         доверенные издатели, подозрительные папки и локальные доверенные корни
                         (Минцифры/Казначейство). Сохраняются сразу и применяются службой через
                         ReloadConfig без перезапуска. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
