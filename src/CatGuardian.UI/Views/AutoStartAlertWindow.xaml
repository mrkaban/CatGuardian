<Window x:Class="CatGuardian.UI.Views.AutoStartAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Al0965}" Width="780" Height="640"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.36: шаблон алерт-окна семейства (см. EtwAlertWindow-эталон):
         баннер вердикта, секции в карточках, единый статус-блок,
         решающие кнопки одной строкой, утилиты в шапке. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="InlineValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="80"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ToolTip" Value="Значение можно выделить и скопировать (Ctrl+C). Полный путь доступен во всплывающей подсказке."/>
        </Style>
        <Style x:Key="HeaderUtilityButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + утилиты справа сверху (3.0.0.36). -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}">
                    ⚠️ Cat Guardian — обнаружено изменение в автозагрузке
                </TextBlock>
                <TextBlock x:Name="AnomalyKindText" Foreground="{DynamicResource AmberBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <Button x:Name="BtnOpenFolder" Style="{StaticResource HeaderUtilityButton}"
                        Content="{loc:Loc Al0966}" Click="OnOpenFolder"
                        ToolTip="{loc:Loc Al0967}"/>
                <Button x:Name="BtnCopyAll" Style="{StaticResource HeaderUtilityButton}"
                        Content="{loc:Loc Al0968}" Margin="0,0,0,0" Click="OnCopyAll"
                        ToolTip="{loc:Loc Al0969}"/>
            </StackPanel>
        </Grid>

        <!-- Баннер вердикта (3.0.0.36). -->
        <Border Grid.Row="1" CornerRadius="4" Padding="12,8"
                Background="#1AFFC107" BorderThickness="1"
                BorderBrush="{DynamicResource AmberBrush}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource AmberBrush}">
                    ⚠️ ПОДОЗРИТЕЛЬНО — изменение автозагрузки
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextBrush}">
                    Программа добавила или изменила запись автозапуска. Так вредоносное ПО закрепляется в системе: объект будет запускаться при входе пользователя без его участия.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <!-- ГДЕ НАЙДЕНО -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al0970}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al0971}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryBranch" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0972}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryName" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0973}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntrySourceText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 3.0.0.36: профиль пользователя для записей HKEY_USERS\<SID> (автозагрузка всех пользователей). -->
                        <StackPanel x:Name="UserRow" Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc Al0974}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryUser" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ПРОГРАММА (КОМАНДНАЯ СТРОКА) -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al0975}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al0976}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryCommand" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="ExeRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0977}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryExe" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="OldValueRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0978}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryOldValue" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- АНАЛИЗ И БЕЗОПАСНОСТЬ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al0979}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al0980}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntrySignature" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0981}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryClam" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 3.0.0.10: репутационная оценка Pre-Scan Heuristics (скрыта, если выключена). -->
                        <StackPanel x:Name="RiskRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0982}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RiskText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="PublisherRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al0983}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="PublisherText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="IocLabel" Text="IOC:" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="EntryIoc" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Значение — двоичные данные реестра (REG_BINARY) -->
                <TextBlock x:Name="ValueKindNote" Foreground="{DynamicResource AmberBrush}"
                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Единый статус-блок + решающие кнопки одной строкой (3.0.0.36). -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="4"
                    Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource AmberBrush}"/>
                    <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ActionsPanel" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnTrust" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al0984}" Margin="0,0,8,0" Click="OnTrust"
                        ToolTip="{loc:Loc Al0985}"/>
                <Button x:Name="BtnDelete" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al0986}" Margin="0,0,8,0" FontWeight="Bold"
                        Background="#D32F2F" Foreground="White" BorderThickness="0" Click="OnDelete"
                        ToolTip="{loc:Loc Al0987}"/>
                <Button x:Name="BtnClose" Content="{loc:Loc Al0988}" IsCancel="True"
                        Style="{StaticResource DecisionButton}" Margin="0,0,0,0" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>