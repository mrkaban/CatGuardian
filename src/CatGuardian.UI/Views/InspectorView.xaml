<UserControl x:Class="CatGuardian.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <!-- 3.0.0.92: все тексты локализованы (Ins.*). -->
    <DockPanel>
        <TabControl x:Name="MainTabs" DockPanel.Dock="Top" Margin="0,0,0,10" SelectionChanged="OnTabChanged">
            <TabItem Header="{loc:Loc Ins.TabScan}"/>
            <TabItem Header="{loc:Loc Ins.TabEvents}"/>
            <TabItem Header="{loc:Loc Ins.TabHoney}"/>
            <TabItem Header="{loc:Loc Ins.TabIoc}"/>
            <TabItem Header="{loc:Loc Ins.TabSettings}"/>
        </TabControl>

        <Grid>
            <!-- Сканирование -->
            <Grid x:Name="ScanPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Ins.ActionsSection}"/>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="24" FontFamily="Segoe UI Emoji" VerticalAlignment="Center">📸</TextBlock>
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           Text="{loc:Loc Ins.BaselineTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="{loc:Loc Ins.BaselineDesc}" Margin="0,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- 3.0.0.78: имена кнопок — для блокировки запуска операций во время сканирования. -->
                                <Button x:Name="BtnBuildBaseline" Content="{loc:Loc Ins.BtnBuild}" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Click="OnBuildBaseline"/>
                                <Button x:Name="BtnFindNew" Content="{loc:Loc Ins.BtnFindNew}" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" HorizontalAlignment="Left" Click="OnFindNew"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="3,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="24" FontFamily="Segoe UI Emoji" VerticalAlignment="Center">🔍</TextBlock>
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           Text="{loc:Loc Ins.IntegrityTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="{loc:Loc Ins.IntegrityDesc}" Margin="0,4,0,12"/>
                            <Button x:Name="BtnCheckIntegrity" Content="{loc:Loc Ins.BtnCheckIntegrity}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Click="OnCheckIntegrity"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="24" FontFamily="Segoe UI Emoji" VerticalAlignment="Center">🎯</TextBlock>
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           Text="{loc:Loc Ins.IocTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="{loc:Loc Ins.IocDesc}" Margin="0,4,0,12"/>
                            <Button x:Name="BtnCheckIoc" Content="{loc:Loc Ins.BtnCheckIoc}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Click="OnCheckIoc"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Grid.Row="2" Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Ins.LastAnalysis}"
                           Margin="0,18,0,8"/>

                <Grid Grid.Row="3">
                    <!-- 3.0.0.81: фильтр результатов — как у IOC (ApplyResultsFilter): строка поиска +
                         категория по Severity; сводка «изменено/новых/критических» в ResultsStatus. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBox x:Name="ResultsFilter" Width="280" VerticalAlignment="Center"
                                 TextChanged="OnResultsFilterChanged"
                                 ToolTip="{loc:Loc Ins.ResultsFilterTooltip}"/>
                        <TextBlock Text="{loc:Loc Ins.ShowLabel}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <!-- 3.0.0.81-fix: Segoe UI Emoji — цветные круги 🟡/🟢 иначе не
                             рендерятся (нет fallback в обычном шрифте UI). -->
                        <ComboBox x:Name="ResultsKindFilter" Width="160" Margin="8,0,0,0"
                                  FontFamily="Segoe UI Emoji"
                                  SelectionChanged="OnResultsKindFilterChanged">
                            <ComboBoxItem Content="{loc:Loc Ins.FilterAll}" Tag="All"/>
                            <ComboBoxItem Content="{loc:Loc Ins.FilterCritical}" Tag="Critical"/>
                            <ComboBoxItem Content="{loc:Loc Ins.FilterChanged}" Tag="Changed"/>
                            <ComboBoxItem Content="{loc:Loc Ins.FilterNew}" Tag="New"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="ResultsStatus" Grid.Row="1" Margin="0,8,0,8"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <!-- 3.0.0.93: VirtualizationMode=Standard (НЕ Recycling). Recycling
                         переиспользует контейнеры строк, и чекбокс с «залипшим» состоянием
                         при перепривязке проталкивал старое значение true в IsSelected
                         ДРУГОЙ (неотмеченной) строки — после «Утвердить» из таблицы
                         пропадали строки, которые пользователь не отмечал. Виртуализация
                         остаётся (IsVirtualizing, EnableRowVirtualization) — отключено
                         только переиспользование контейнеров, на больших списках это
                         не критично. -->
                    <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="OnResultsSelectionChanged"
                              MouseDoubleClick="OnResultsGridDoubleClick"
                              KeyDown="OnResultsGridKeyDown"
                              ContextMenuOpening="OnResultsContextMenuOpening"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <!-- D3 (3.0.0.18): выделение через свойство строки IsSelected —
                             «Выделить все» мгновенно (без SelectAll на сотнях тысяч строк),
                             подсветка выбранных — фоном через DataTrigger. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#30FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="OnRowCheckChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 3.0.0.81: SortMemberPath=Severity — сортировка по степени угрозы
                                 (template-колонки встроенно не сортируются). -->
                            <DataGridTemplateColumn x:Name="ResultsKindColumn" Header="{loc:Loc Ins.ColVerdict}" Width="160"
                                                    SortMemberPath="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kind}" FontFamily="Segoe UI Emoji" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="2">
                                                            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Ins.ColObject}" Binding="{Binding Path}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Ins.ColDetail}" Binding="{Binding Detail}" Width="280">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <!-- 3.0.0.84: копирование пути/хэша и папки для всех выбранных. -->
                                <MenuItem Header="{loc:Loc Ins.CtxOpenFolder}" Click="OnOpenResultFolder"/>
                                <MenuItem Header="{loc:Loc Ins.CtxOpenFolders}" Click="OnOpenResultFolders"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Ins.CtxCopyPath}" Click="OnCopyResultPath"/>
                                <MenuItem Header="{loc:Loc Ins.CtxCopyHash}" Click="OnCopyResultHash"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Ins.CtxApprove}" Click="OnApproveResults"/>
                                <MenuItem Header="{loc:Loc Ins.CtxReject}" Click="OnRejectResults"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Ins.CtxSelectAll}" Click="OnSelectAllResults"/>
                                <MenuItem Header="{loc:Loc Ins.CtxClearSel}" Click="OnClearResultsSelection"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <!-- 3.0.0.78: кнопка «✖ Прервать» рядом с прогресс-баром — видна только во время операции. -->
                    <DockPanel>
                        <Button x:Name="BtnCancelScan" Content="{loc:Loc Ins.BtnCancel}" Click="OnCancelScan"
                                DockPanel.Dock="Right" Margin="10,0,0,0" Padding="12,5"
                                VerticalAlignment="Center" IsEnabled="False" Visibility="Collapsed"/>
                        <ProgressBar x:Name="ScanProgress" Height="18" Maximum="100" Minimum="0" Value="0"/>
                    </DockPanel>
                    <TextBlock x:Name="ScanStatus" Margin="0,8,0,8" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ResultsActions" Orientation="Horizontal">
                        <Button x:Name="BtnApprove" Content="{loc:Loc Ins.CtxApprove}" IsEnabled="False" Click="OnApproveResults"/>
                        <Button x:Name="BtnReject" Content="{loc:Loc Ins.BtnReject}" Margin="8,0,0,0" IsEnabled="False" Click="OnRejectResults"/>
                        <Button x:Name="BtnSelectAll" Content="{loc:Loc Ins.CtxSelectAll}" Margin="8,0,0,0" IsEnabled="False" Click="OnSelectAllResults"/>
                        <Button x:Name="BtnClearSel" Content="{loc:Loc Ins.BtnClearSel}" Margin="8,0,0,0" IsEnabled="False" Click="OnClearResultsSelection"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- События -->
            <Grid x:Name="EventsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Ins.BtnRefresh}" Click="OnRefreshEvents"/>
                        <TextBlock Text="{loc:Loc Ins.SourceLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ComboBox x:Name="EventsSourceFilter" Width="120" Margin="6,0,0,0" SelectionChanged="OnEventsFilterChanged">
                            <ComboBoxItem Content="{loc:Loc Ins.FilterAll}" Tag=""/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvFiles}" Tag="File"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvRegistry}" Tag="Registry"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvHoney}" Tag="Honeypot"/>
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Ins.TypeLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ComboBox x:Name="EventsTypeFilter" Width="140" Margin="6,0,0,0" SelectionChanged="OnEventsFilterChanged">
                            <ComboBoxItem Content="{loc:Loc Ins.FilterAll}" Tag=""/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvTypeMalicious}" Tag="Malicious"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvTypeNew}" Tag="NewFile"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvTypeModified}" Tag="Modified"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvTypeDeleted}" Tag="Deleted"/>
                            <ComboBoxItem Content="{loc:Loc Ins.EvTypeOther}" Tag="Unknown"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- 3.0.0.86: лимит выборки и фильтр по дате. Диапазон передаётся
                         в SQL-запрос до LIMIT, поэтому выборка всегда корректна. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{loc:Loc Ins.LimitLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <!-- 3.0.0.86-fix: SelectedIndex задаётся в коде ПОСЛЕ создания всех контролов —
                             иначе SelectionChanged при загрузке XAML обращался бы к не созданным
                             EventsFrom/EventsTo (NullReferenceException). -->
                        <ComboBox x:Name="EventsLimit" Width="80" Margin="6,0,0,0"
                                  SelectionChanged="OnEventsFilterChanged">
                            <ComboBoxItem Content="100" Tag="100"/>
                            <ComboBoxItem Content="500" Tag="500"/>
                            <ComboBoxItem Content="1000" Tag="1000"/>
                            <ComboBoxItem Content="5000" Tag="5000"/>
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Ins.FromLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <DatePicker x:Name="EventsFrom" Width="125" Margin="6,0,0,0"
                                    SelectedDateChanged="OnEventsDateChanged" LostFocus="OnEventsDateLostFocus"
                                    ToolTip="{loc:Loc Ins.FromTooltip}"/>
                        <TextBlock Text="{loc:Loc Ins.ToLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <DatePicker x:Name="EventsTo" Width="125" Margin="6,0,0,0"
                                    SelectedDateChanged="OnEventsDateChanged" LostFocus="OnEventsDateLostFocus"
                                    ToolTip="{loc:Loc Ins.ToTooltip}"/>
                        <Button Content="{loc:Loc Ins.PresetToday}" Margin="12,0,0,0" Tag="today" Click="OnEventsPresetClick"/>
                        <Button Content="{loc:Loc Ins.Preset7d}" Margin="6,0,0,0" Tag="7d" Click="OnEventsPresetClick"/>
                        <Button Content="{loc:Loc Ins.Preset30d}" Margin="6,0,0,0" Tag="30d" Click="OnEventsPresetClick"/>
                        <Button Content="{loc:Loc Ins.PresetAll}" Margin="6,0,0,0" Tag="all" Click="OnEventsPresetClick"/>
                    </StackPanel>
                    <TextBlock x:Name="EventsStatus" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <DataGrid x:Name="EventsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="OnEventsGridDoubleClick">
                    <!-- Подсветка: приманки — жёлтым, вредоносное ПО (IOC) — красным (п.18). -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source}" Value="Honeypot">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Malicious">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Dash.ColTime}" Binding="{Binding TimeText}" Width="150"/>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColSource}" Binding="{Binding SourceText}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColType}" Binding="{Binding TypeText}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColObject}" Binding="{Binding Target}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Приманки -->
            <ScrollViewer x:Name="HoneypotPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnHoneypotPreviewMouseWheel">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Style="{StaticResource SectionTitleUpper}" FontFamily="Segoe UI Emoji"
                               Text="{loc:Loc Ins.HoneySection}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                        <TextBlock Text="{loc:Loc Ins.HoneyStatus}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HoneyStatusTag" Text="{loc:Loc Ins.HoneyStatusChecking}" FontFamily="Segoe UI Emoji" FontWeight="Bold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource AmberBrush}"/>
                        <CheckBox x:Name="HoneyEnabled" Content="{loc:Loc Ins.HoneyEnable}" FontFamily="Segoe UI Emoji"
                                  Margin="24,0,0,0" VerticalAlignment="Center" Checked="OnHoneyEnabledChanged" Unchecked="OnHoneyEnabledChanged"/>
                        <TextBlock Text="{loc:Loc Ins.HoneyListener}" Foreground="{DynamicResource MutedBrush}"
                                   Margin="18,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="127.0.0.1:8085" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Управление модулем — ВЫШЕ зон развертывания (п.19). -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontFamily="Segoe UI Emoji" Text="{loc:Loc Ins.HoneyControl}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:Loc Ins.HoneyCreate}" FontFamily="Segoe UI Emoji" Click="OnCreateHoneypot"/>
                                <Button Content="{loc:Loc Ins.HoneyRegen}" FontFamily="Segoe UI Emoji" Margin="8,0,0,0" Click="OnRegenerateHoneypot"/>
                                <Button Content="{loc:Loc Ins.HoneyDelete}" FontFamily="Segoe UI Emoji" Margin="8,0,0,0" Click="OnDeleteHoneypot"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Зоны развертывания приманок -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontFamily="Segoe UI Emoji" Text="{loc:Loc Ins.HoneyZones}"/>
                            <CheckBox x:Name="HoneyCanary" Content="{loc:Loc Ins.HoneyCanary}"
                                      FontFamily="Segoe UI Emoji" Margin="0,6,0,0" Checked="OnHoneyCanaryChanged" Unchecked="OnHoneyCanaryChanged"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="ZoneDesktop" Content="{loc:Loc Ins.ZoneDesktop}" FontFamily="Segoe UI Emoji" Margin="0,4" IsChecked="True" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                    <CheckBox x:Name="ZoneDocuments" Content="{loc:Loc Ins.ZoneDocuments}" FontFamily="Segoe UI Emoji" Margin="0,4" IsChecked="True" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                    <!-- 3.0.0.15: зоны Загрузок/Изображений перенесены из модуля
                                         защиты от шифровальщиков в единый пул приманок Инспектора. -->
                                    <CheckBox x:Name="ZoneDownloads" Content="{loc:Loc Ins.ZoneDownloads}" FontFamily="Segoe UI Emoji" Margin="0,4" IsChecked="True" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="ZoneDev" Content="{loc:Loc Ins.ZoneDev}" FontFamily="Segoe UI Emoji" Margin="0,4" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                    <CheckBox x:Name="ZoneBrowser" Content="{loc:Loc Ins.ZoneBrowser}" FontFamily="Segoe UI Emoji" Margin="0,4" IsChecked="True" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                    <!-- 3.0.0.44 (RW2): зона мессенджеров — decoy в tdata Telegram Desktop (по умолчанию выкл). -->
                                    <CheckBox x:Name="ZoneMessenger" Content="{loc:Loc Ins.ZoneMessenger}" FontFamily="Segoe UI Emoji" Margin="0,4" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                    <CheckBox x:Name="ZonePictures" Content="{loc:Loc Ins.ZonePictures}" FontFamily="Segoe UI Emoji" Margin="0,4" Checked="OnHoneyZoneChanged" Unchecked="OnHoneyZoneChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Файлы-приманки — таблица как в 2.2 (п.7). -->
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Ins.HoneyFilesSection}" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <!-- Grid вместо StackPanel: StackPanel даёт DataGrid бесконечную предлагаемую
                             ширину, из-за чего колонки (особенно Width="*") схлопываются до 1px (#7). -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="HoneyGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="280" BorderThickness="0" SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <!-- Точные ширины как в 2.2: без MinWidth, чтобы не было горизонт. скролла (#4). -->
                                    <DataGridTextColumn Header="{loc:Loc Ins.ColType}" Binding="{Binding KindText}" Width="150"/>
                                    <DataGridTextColumn Header="{loc:Loc Ins.ColName}" Binding="{Binding DisplayName}" Width="200"/>
                                    <DataGridTextColumn Header="{loc:Loc Ins.ColPath}" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Ins.ColCreated}" Binding="{Binding CreatedText}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Ins.ColStatus}" Binding="{Binding StatusText}" Width="90"/>
                                    <DataGridTemplateColumn Header="{loc:Loc Ins.ColActions}" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{loc:Loc Ins.BtnDelete}" Padding="6,2" Click="OnHoneyDelete"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HoneyListHint" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="14,8,14,10"/>
                        </Grid>
                    </Border>

                    <!-- Последний инцидент -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontFamily="Segoe UI Emoji" Text="{loc:Loc Ins.HoneyIncidentTitle}"/>
                            <TextBlock x:Name="HoneyIncident" FontFamily="Segoe UI Emoji" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="22"
                                       MouseLeftButtonUp="OnHoneyIncidentClick" Cursor="Hand"
                                       ToolTip="{loc:Loc Ins.HoneyIncidentTooltip}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- IOC -->
            <Grid x:Name="IocPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Ins.IocRefresh}" Click="OnRefreshIoc"/>
                        <Button Content="{loc:Loc Ins.BtnAddPlus}" Margin="8,0,0,0" Click="OnAddIoc"/>
                        <Button Content="{loc:Loc Ins.BtnEdit}" Margin="8,0,0,0" Click="OnEditIoc"/>
                        <Button Content="{loc:Loc Ins.BtnDeleteX}" Margin="8,0,0,0" Click="OnDeleteIoc"/>
                        <Button Content="{loc:Loc Ins.BtnBulk}" Margin="8,0,0,0" Click="OnBulkAddIoc"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="IocFilter" Width="280" VerticalAlignment="Center"
                                 TextChanged="OnIocFilterChanged" ToolTip="{loc:Loc Ins.IocFilterTooltip}"/>
                        <TextBlock Text="{loc:Loc Ins.AlgoLabel}" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ComboBox x:Name="IocAlgoFilter" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="OnIocAlgoFilterChanged">
                            <ComboBoxItem Content="{loc:Loc Ins.FilterAll}"/>
                            <ComboBoxItem Content="sha256"/>
                            <ComboBoxItem Content="sha1"/>
                            <ComboBoxItem Content="md5"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="IocStatus" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <DataGrid x:Name="IocGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColHash}" Binding="{Binding Hash}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColAlgo}" Binding="{Binding Algo}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Ins.ColDescription}" Binding="{Binding Description}" Width="240"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Настройки -->
            <ScrollViewer x:Name="ConfPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Блоки настроек растягиваются на всю доступную ширину (п.21). -->
                <Grid Margin="0,0,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitleUpper}"
                               Text="{loc:Loc Ins.ConfSection}"/>

                    <!-- 3.0.0.77: два отдельных блока каталогов — «постоянно» (watcher real-time)
                         и «по запросу» (только ручные проверки), по образцу веток реестра. -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <!-- TextWrapping=Wrap: длинные заголовки не должны раздувать карточку (#9/#15). -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfRootsTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Ins.ConfRootsHint}"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <ListBox x:Name="ConfRootsList" Height="70"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:Loc Ins.BtnAddPlus}" Click="OnAddRoot"/>
                                    <Button Content="{loc:Loc Ins.BtnDeleteX}" Margin="8,0,0,0" Click="OnRemoveRoot"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfDirsOnDemandTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Ins.ConfDirsOnDemandHint}"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <ListBox x:Name="ConfDirsOnDemandList" Height="70"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:Loc Ins.BtnAddPlus}" Click="OnAddOnDemandDir"/>
                                    <Button Content="{loc:Loc Ins.BtnDeleteX}" Margin="8,0,0,0" Click="OnRemoveOnDemandDir"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3.0.0.80: ветки реестра — правая колонка первой строки, напротив каталогов. -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                        <!-- 3.0.0.60: два отдельных блока реестровых веток (без эмодзи). -->
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfRegTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Ins.ConfRegHint}"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <ListBox x:Name="ConfRegList" Height="80"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:Loc Reg.BtnAdd}" Click="OnAddRegKey"/>
                                    <Button Content="{loc:Loc Reg.BtnRemove}" Margin="8,0,0,0" Click="OnRemoveRegKey"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfRegOnDemandTitle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Reg.OnDemandHint}"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <ListBox x:Name="ConfRegOnDemandList" Height="80"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="{loc:Loc Reg.BtnAdd}" Click="OnAddOnDemandRegKey"/>
                                    <Button Content="{loc:Loc Reg.BtnRemove}" Margin="8,0,0,0" Click="OnRemoveOnDemandRegKey"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3.0.0.80: расширения файлов — левая карточка второй строки. -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,10,6,0" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfExtTitle}" TextWrapping="Wrap"/>
                            <!-- 3.0.0.64: автоприменение при вводе (дебаунс в code-behind). -->
                            <TextBox x:Name="ConfExtBox" TextWrapping="Wrap" Height="80" AcceptsReturn="True"
                                     TextChanged="OnConfExtChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="6,10,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfExclTitle}" TextWrapping="Wrap"/>
                            <ListBox x:Name="ConfExclList" Height="80"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{loc:Loc Ins.BtnAddPlus}" Click="OnAddExclusion"/>
                                <Button Content="{loc:Loc Ins.BtnDeleteX}" Margin="8,0,0,0" Click="OnRemoveExclusion"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3.0.0.22: отдельный переключатель уведомлений ИНСПЕКТОРА — не путать
                         с глобальным «Всплывающие уведомления» в «Настройках» (toasts_enabled),
                         который отключает ВСЕ баллуны комплекса. Этот влияет только на общий
                         tray-balloon о событиях File Watcher (файлы/реестр/приманки). -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfNotifyTitle}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ConfNotifyBox"
                                      Content="{loc:Loc Ins.ConfNotifyBox}"
                                      Margin="0,6,0,0" VerticalAlignment="Center"
                                      Checked="OnConfNotifyChanged" Unchecked="OnConfNotifyChanged"/>
                            <TextBlock Text="{loc:Loc Ins.ConfNotifyHint}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3.0.0.80: режим проверки целостности и IOC-проверка ручных операций
                         инспектора («Снять эталон», «Найти новые», «Проверить целостность»).
                         На «Комплексную»/«Быструю + IOC» проверки и кнопку «Проверить IOC»
                         настройки не влияют — там IOC заложен отдельными этапами. -->
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Ins.ConfIntegrityTitle}" TextWrapping="Wrap"/>

                            <CheckBox x:Name="ConfFastBox"
                                      Content="{loc:Loc Ins.ConfFastBox}"
                                      Margin="0,8,0,2" HorizontalAlignment="Left"
                                      Checked="OnConfFastIntegrityChanged" Unchecked="OnConfFastIntegrityChanged"/>
                            <TextBlock Text="{loc:Loc Ins.ConfFastHint}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Margin="24,0,0,6" LineHeight="16"/>

                            <CheckBox x:Name="ConfIocBox"
                                      Content="{loc:Loc Ins.ConfIocBox}"
                                      Margin="0,8,0,2" HorizontalAlignment="Left"
                                      Checked="OnConfIocChanged" Unchecked="OnConfIocChanged"/>
                            <TextBlock Text="{loc:Loc Ins.ConfIocHint}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Margin="24,0,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- 3.0.0.80: нижний лейбл «Все настройки…» удалён — настройки применяются
                         сразу при изменении, дополнительная подпись не нужна. -->
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>