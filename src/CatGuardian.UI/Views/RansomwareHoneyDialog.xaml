<Window x:Class="CatGuardian.UI.Views.RansomwareHoneyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Inspector.HoneyTitle}" Width="620" Height="460"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.92: тексты локализованы (Inspector.Honey*). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{loc:Loc Inspector.HoneyHeader}"/>
            <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="{loc:Loc Inspector.HoneyIntro}"/>
        </StackPanel>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
            <StackPanel>
                <Border Background="#1AFFB020" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"
                                   Text="{loc:Loc Inspector.HoneyWhyTitle}"/>
                        <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{loc:Loc Inspector.HoneyWhyText}"/>
                    </StackPanel>
                </Border>

                <Border Background="#1AF44336" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource RedBrush}"
                                   Text="{loc:Loc Inspector.HoneyWithoutTitle}"/>
                        <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Text="{loc:Loc Inspector.HoneyWithoutText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки (3.0.1.2: WrapPanel — длинные подписи не помещались в одну строку
             при ширине окна 620px; теперь вторая кнопка переносится на новую строку). -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Inspector.HoneyBtnWithout}"
                    Margin="0,0,10,0" Padding="14,8" Click="OnContinueWithout"/>
            <Button Content="{loc:Loc Inspector.HoneyBtnEnable}"
                    Style="{StaticResource PrimaryButton}" Padding="14,8"
                    Click="OnEnableAndGo"/>
        </WrapPanel>
    </Grid>
</Window>
