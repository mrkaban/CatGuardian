<Window x:Class="CatGuardian.UI.Views.LogEntryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Inspector.LogDetailsTitle}"
        Width="680" Height="500" MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Inspector.LogDetailsHeader}" Style="{StaticResource SectionTitleUpper}"/>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Метаданные записи -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Dash.ColModule}" Style="{StaticResource SectionTitleUpper}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ModuleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc Dash.ColLevel}" Style="{StaticResource SectionTitleUpper}" Margin="0,0,0,4"/>
                        <Border x:Name="LevelBadge" CornerRadius="4" Padding="12,4" HorizontalAlignment="Left">
                            <TextBlock x:Name="LevelText" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Common.Date}" Style="{StaticResource SectionTitleUpper}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DateText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc Dash.ColTime}" Style="{StaticResource SectionTitleUpper}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TimeText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Полный текст сообщения -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc Dash.ColMessage}" Style="{StaticResource SectionTitleUpper}" Margin="16,12,16,4"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="4,0,4,4">
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                               Foreground="{DynamicResource TextBrush}" LineHeight="20"
                               Margin="12,4,12,12"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc Common.Close}" Padding="18,7" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>