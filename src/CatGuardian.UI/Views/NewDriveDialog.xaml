<Window x:Class="CatGuardian.UI.Views.NewDriveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Av.NewDriveTitle}"
        Width="580" SizeToContent="Height" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <!-- 3.0.0.92: тексты локализованы (Av.*); заодно убрано устаревшее имя «МойАнтивирус». -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel>
            <TextBlock Text="{loc:Loc Av.NewDriveHeader}" Style="{StaticResource SectionTitleUpper}"/>
            <TextBlock Text="{loc:Loc Av.NewDriveSub}"
                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Карточка с информацией о диске -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc Av.NewDriveCard}" Style="{StaticResource SectionTitleUpper}" Margin="0,0,0,6"/>
                <TextBlock x:Name="DriveText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Loc Av.NewDriveAdvice}"
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Больше не спрашивать -->
        <CheckBox x:Name="RememberCheck" Grid.Row="2" Content="{loc:Loc Av.NewDriveRemember}"
                  Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="2,14,0,0"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Av.BtnScan}" Padding="18,8" Click="OnScan" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Av.BtnIgnore}" Padding="18,8" Click="OnIgnore" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Av.BtnAvSettings}" Padding="18,8" Click="OnSettings"/>
        </StackPanel>
    </Grid>
</Window>
