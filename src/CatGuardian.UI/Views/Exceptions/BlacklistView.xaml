<UserControl x:Class="CatGuardian.UI.Views.Exceptions.BlacklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <!-- 3.0.0.69: раздел «Чёрный список» в общих настройках — персистентные запреты
         модулей (кнопка «Запретить» в алертах), сгруппированные по модулям.
         Удаление записи возвращает обычный цикл проверки (алерт при следующем обращении). -->
    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Blk.Title}"/>

            <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,2" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Loc Blk.Hint}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnRefresh" Content="{loc:Loc Fw.BtnRefreshList}" Click="OnRefresh"
                        HorizontalAlignment="Left" Padding="10,4"/>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
            </StackPanel>

            <ItemsControl x:Name="GroupsList" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="False" Margin="0,2">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                            Visibility="{Binding IndicatorVisibility}"/>
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="{Binding HeaderWeight}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Items}" Margin="10,6,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding DisplayValue}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullDisplay}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="{loc:Loc Blk.BtnRemove}"
                                                    Tag="{Binding Item}" Click="OnRemoveItem"
                                                    Padding="8,3" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="WarningsText" Foreground="{DynamicResource AmberBrush}" Margin="0,8,0,0"
                       FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                       Text="{loc:Loc Blk.Empty}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>