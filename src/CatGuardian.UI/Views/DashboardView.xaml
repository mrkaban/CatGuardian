<UserControl x:Class="CatGuardian.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Статус кота: cat_sleep.png слева от текста (п.1). -->
            <!-- D1 (3.0.0.18→3.0.0.19): фон шапки — фиксированный плиточный узор №11
                 («Уголки с точкой»); листалка узоров убрана. Узор строится кодом
                 (BannerBack.Background), плитка 56x56, TileMode=Tile. -->
            <Border Style="{DynamicResource Card}" Background="{DynamicResource PanelBrush}" Padding="12">
                <Grid>
                    <!-- Фон-узор: заполняется из DashboardView.ApplyBannerPattern(). -->
                    <Border x:Name="BannerBack" IsHitTestVisible="False" Opacity="0.16"/>
                    <DockPanel>
                        <Image x:Name="CatImage" Width="190" Height="190" Stretch="Uniform"
                               DockPanel.Dock="Left" Margin="0,0,14,0" Source="Resources/cat_sleep.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <!-- 3.0.0.92: стартовые тексты — из локализации; далее их обновляет код
                                 (DashboardView.xaml.cs) строками Tr.T по тем же ключам. -->
                            <TextBlock x:Name="CatTitle" Text="{loc:Loc Dash.StatusIdle}" FontSize="18"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="CatSubtitle" Text="{loc:Loc Dash.StatusIdleSub}" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource GreenBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Foreground="{DynamicResource GreenBrush}"
                                           FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                                           ToolTip="{loc:Loc Dash.StatusTooltip}"
                                           MouseLeftButtonUp="OnStatusClick"
                                           Text="{loc:Loc Dash.AllMonitorsActive}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Экспресс-анализ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{DynamicResource PrimaryButton}" Padding="18,12"
                        Click="OnQuickVirusScan" Content="{loc:Loc Dash.QuickVirus}"/>
                <Button Style="{StaticResource {x:Type Button}}" Padding="18,12" Margin="12,0,0,0"
                        Click="OnQuickScan" Content="{loc:Loc Dash.QuickVirusIoc}"/>
                <Button Style="{StaticResource {x:Type Button}}" Padding="18,12" Margin="12,0,0,0"
                        Click="OnFullScan" Content="{loc:Loc Dash.FullScan}"/>
            </StackPanel>

            <!-- Состояние компонентов -->
            <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Dash.ComponentsSection}"
                       Margin="0,14,0,8"/>

            <UniformGrid Columns="3">
                <Border Style="{DynamicResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   Text="{loc:Loc Dash.CardInspector}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Dash.MonitorActive}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource GreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="InspBaseline" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.BaselineCount}"/>
                        <TextBlock x:Name="InspIoc" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.IocCount}"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   Text="{loc:Loc Dash.CardFirewall}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Ellipse x:Name="FwDot" Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FwState" Text="{loc:Loc Dash.FirewallPending}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource GreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="FwRules" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.FwRules}"/>
                        <TextBlock x:Name="FwThreats" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.FwThreats}"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   Text="{loc:Loc Dash.CardAntivirus}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AvState" Text="{loc:Loc Dash.MonitorOn}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource GreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="AvSign" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.Signatures}"
                                   Cursor="Hand" ToolTip="{loc:Loc Dash.AvSignTooltip}"
                                   MouseLeftButtonUp="OnAvSignClick"/>
                        <TextBlock x:Name="AvQuar" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.Quarantine}"/>
                        <TextBlock x:Name="AvLastScan" Style="{StaticResource SubLabel}" Text="{loc:Loc Dash.LastScan}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Последние события -->
            <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Dash.RecentEvents}"
                       Margin="0,14,0,8"/>
            <Border Style="{DynamicResource Card}" Padding="0">
                <DataGrid x:Name="LogGrid" Height="150" BorderThickness="0" AutoGenerateColumns="False"
                          VerticalScrollBarVisibility="Auto" MouseDoubleClick="OnLogDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Dash.ColTime}" Binding="{Binding TimeText}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Dash.ColModule}" Binding="{Binding Module}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc Dash.ColLevel}" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Loc Dash.ColMessage}" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>