<Window x:Class="CatGuardian.UI.Views.SandboxAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Al1794}" Width="800" Height="660"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.39: Песочница (AppContainer). Шаблон алерт-окна семейства
         (см. MinerAlertWindow-эталон 3.0.0.36): баннер вердикта, секции «КТО → ЧТО → АНАЛИЗ»,
         единый статус-блок, решающие кнопки одной строкой. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="InlineValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="80"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ToolTip" Value="{loc:Loc Common.ValueCopyHint}"/>
        </Style>
        <Style x:Key="HeaderUtilityButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{loc:Loc Sbx.HeaderTitle}"/>
                <TextBlock x:Name="ThreatKindText" Foreground="{DynamicResource RedBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <Button Style="{StaticResource HeaderUtilityButton}" Content="{loc:Loc Al1795}"
                        Margin="0,0,0,0" Click="OnCopyAll"
                        ToolTip="{loc:Loc Al1796}"/>
            </StackPanel>
        </Grid>

        <!-- Баннер вердикта -->
        <Border x:Name="VerdictBorder" Grid.Row="1" CornerRadius="4" Padding="12,8"
                Background="#1AF44336" BorderThickness="1"
                BorderBrush="{DynamicResource RedBrush}">
            <StackPanel>
                <TextBlock x:Name="VerdictTitle" FontSize="14" FontWeight="Bold"
                           TextWrapping="Wrap" Foreground="{DynamicResource RedBrush}"/>
                <TextBlock x:Name="VerdictMeaning" FontSize="12" TextWrapping="Wrap"
                           Margin="0,2,0,0" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <!-- КТО ЗАПУЩЕН -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1797}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al1798}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProcessNameText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="PID:" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="PidText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="PathRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1799}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProcessPathText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1800}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <TextBox x:Name="CmdLineText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" MaxHeight="70"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ЧТО ПРЕДЛАГАЕТСЯ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1801}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <TextBox x:Name="DetailsText" Style="{StaticResource InlineValue}" MinHeight="60"/>
                </Border>

                <!-- АНАЛИЗ И БЕЗОПАСНОСТЬ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1802}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al1803}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RiskText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1804}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SignatureText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1805}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TimeText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Единый статус-блок + решающие кнопки -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="StatusBlock" Grid.Row="0" Background="#14FFFFFF" CornerRadius="4"
                    Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource AmberBrush}"/>
                    <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 3.0.1.2: WrapPanel вместо StackPanel — шесть решающих кнопок не помещались
                 в одну строку при ширине окна 800px (и тем более при MinWidth 680px);
                 теперь при нехватке места кнопки переносятся на следующую строку. -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnSkip" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1806}" Margin="0,0,8,0" Click="OnSkip"
                        ToolTip="{loc:Loc Al1807}"/>
                <!-- 3.0.0.91 (Launch Gate): «▶ Запустить» — разморозить процесс без добавления в доверенные.
                     Виден только в упреждающем репутационном диалоге (ReputationGate), когда песочница выключена. -->
                <Button x:Name="BtnAllow" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1808}" Margin="0,0,8,0" FontWeight="Bold"
                        Background="#1B5E20" Foreground="White" BorderThickness="0" Click="OnAllow"
                        Visibility="Collapsed"
                        ToolTip="{loc:Loc Al1809}"/>
                <Button x:Name="BtnTrust" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1810}" Margin="0,0,8,0" Click="OnTrust"
                        ToolTip="{loc:Loc Al1811}"/>
                <Button x:Name="BtnKill" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1812}" Margin="0,0,8,0" FontWeight="Bold"
                        Background="#D32F2F" Foreground="White" BorderThickness="0" Click="OnKill"
                        ToolTip="{loc:Loc Al1813}"/>
                <Button x:Name="BtnLaunch" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1814}" Margin="0,0,8,0" FontWeight="Bold"
                        Background="#1B5E20" Foreground="White" BorderThickness="0" Click="OnLaunchInSandbox"
                        ToolTip="{loc:Loc Al1815}"/>
                <Button Content="{loc:Loc Al1816}" IsCancel="True" Style="{StaticResource DecisionButton}"
                        Margin="0,0,0,0" Click="OnClose"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>