<Window x:Class="CatGuardian.UI.Views.ScanDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scan="clr-namespace:CatGuardian.UI.Scanning"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Sdw.Title}"
        Width="920" Height="720"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <scan:BrushKeyToBrushConverter x:Key="BrushKeyConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <scan:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="WindowTitleText" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="{Binding StatusCaption, Mode=OneWay}" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- Живая панель: прогресс + текущий файл -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsFinished, Converter={StaticResource InvBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Height="10" Maximum="100" Minimum="0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                           Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0}%}"/>
            </Grid>
            <!-- Одна строка с обрезкой: длинный путь не переносится и не ломает layout -->
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="22" ToolTip="{Binding CurrentFile, Mode=OneWay}">
                <Run Text="{loc:Loc Sdw.CurrentFile}"/>
                <Run Text="{Binding CurrentFile, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
            </TextBlock>
        </StackPanel>

        <!-- Живой контент: этапы + статистика + лог -->
        <Grid Grid.Row="2" Margin="0,12,0,0"
              Visibility="{Binding IsFinished, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Чек-лист этапов -->
                <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Sdw.Stages}"/>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="15"
                                                   VerticalAlignment="Top"
                                                   Foreground="{Binding IconBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedBrush}" MaxWidth="420"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Статистика -->
                <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Sdw.Stats}"/>
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextBrush}">
                            <Run Text="{loc:Loc Sdw.FilesChecked}"/>
                            <Run Text="{Binding FilesChecked, Mode=OneWay, StringFormat={}{0}}" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}">
                            <Run Text="{loc:Loc Sdw.ThreatsFound}"/>
                            <Run Text="{Binding Threats.Count, Mode=OneWay}" FontWeight="Bold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasThreats}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>

                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}">
                            <Run Text="{loc:Loc Sdw.Elapsed}"/>
                            <Run Text="{Binding ElapsedText, Mode=OneWay}" FontWeight="Bold" FontFamily="Consolas"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Живой журнал: занимает остаток высоты, скролл не выходит за окно -->
            <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Sdw.LogTitle}"/>
                    <DataGrid Grid.Row="1" x:Name="LogGrid" ItemsSource="{Binding Log}" AutoGenerateColumns="False"
                              IsReadOnly="True" Margin="0,8,0,0" MinHeight="140"
                              BorderThickness="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColTime}" Binding="{Binding Time}" Width="76"/>
                            <DataGridTextColumn Header="{loc:Loc Sdw.Component}" Binding="{Binding Component}" Width="140"/>
                            <DataGridTemplateColumn Header="{loc:Loc Fw.ColMessage}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding LevelBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Итоговый экран (Summary) ============ -->
        <Grid Grid.Row="2" Margin="0,12,0,0"
              Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Баннер статуса -->
            <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SummaryIcon}" FontFamily="Segoe UI Emoji" FontSize="34"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding SummaryBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SummaryTitle}" FontSize="19" FontWeight="Bold"
                                       Foreground="{Binding SummaryBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                            <TextBlock Text="{loc:Loc Sdw.AbortedNote}"
                                       Margin="0,3,0,0" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryDetail}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" MaxHeight="38"/>
                </StackPanel>
            </Border>

            <!-- Статистика -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,10,0,0">
                <Border Style="{DynamicResource Card}" Padding="10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.FilesCheckedShort}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding FilesChecked, Mode=OneWay, StringFormat={}{0}}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Padding="10" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.VirusesFound}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Threats.Count, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThreats}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Padding="10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.FilesChanged}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding IntegrityStatText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIntegrityChanges}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Padding="10" Margin="0,6,6,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.CheckTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding ElapsedText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Padding="10" Margin="3,6,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.SigDate}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding SignaturesDate, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Padding="10" Margin="6,6,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Sdw.ActiveThreats}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding ActiveThreatCount, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Вкладки с результатами (видны при наличии проблем) -->
            <TabControl Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding HasAnyIssues, Converter={StaticResource BoolToVis}}">
                <!-- Вредоносные программы -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding ThreatTabTitle, Mode=OneWay}"/>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ThreatsGrid" ItemsSource="{Binding Threats}" AutoGenerateColumns="False"
                                  IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Sdw.FilePath}" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Sdw.DetectedThreat}" Binding="{Binding Alert}" Width="280"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="QuarantineBtn" Content="{loc:Loc Sdw.BtnQuarantine}" FontFamily="Segoe UI Emoji"
                                    Style="{StaticResource PrimaryButton}" Padding="14,7" Click="OnQuarantine"/>
                            <Button x:Name="DeleteBtn" Content="{loc:Loc Sdw.BtnDelete}" FontFamily="Segoe UI Emoji"
                                    Padding="14,7" Margin="10,0,0,0" Click="OnDeleteThreats"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Целостность системы -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding IntegrityTabTitle, Mode=OneWay}"/>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="IntegrityGrid" ItemsSource="{Binding IntegrityChanges}" AutoGenerateColumns="False"
                                  IsReadOnly="True" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Sdw.FilePath}" Binding="{Binding Path}" Width="*"/>
                                <DataGridTemplateColumn Header="{loc:Loc Sdw.State}" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource BrushKeyConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="ApproveBtn" Content="{loc:Loc Sdw.Approve}" FontFamily="Segoe UI Emoji"
                                    Style="{StaticResource PrimaryButton}" Padding="14,7" Click="OnApproveBaseline"
                                    ToolTip="{loc:Loc Sdw.ApproveTooltip}"/>
                            <Button x:Name="RejectBtn" Content="{loc:Loc Fw.BtnDelete}" FontFamily="Segoe UI Emoji"
                                    Padding="14,7" Margin="10,0,0,0" Click="OnRejectIntegrity"
                                    ToolTip="{loc:Loc Sdw.RejectTooltip}"/>
                            <Button x:Name="SelectAllIntegrityBtn" Content="{loc:Loc Ins.CtxSelectAll}" FontFamily="Segoe UI Emoji"
                                    Padding="14,7" Margin="10,0,0,0" Click="OnSelectAllIntegrity"/>
                            <Button x:Name="SelectNoneIntegrityBtn" Content="{loc:Loc Sdw.SelectNone}" FontFamily="Segoe UI Emoji"
                                    Padding="14,7" Margin="10,0,0,0" Click="OnSelectNoneIntegrity"/>
                            <Button x:Name="OpenFolderBtn" Content="{loc:Loc Sdw.OpenFolder}" FontFamily="Segoe UI Emoji"
                                    Padding="14,7" Margin="10,0,0,0" Click="OnOpenFolder"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Чистый результат: без проблем вкладки не показываем -->
            <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="20" Margin="0,10,0,0"
                    Visibility="{Binding HasAnyIssues, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="{loc:Loc Sdw.NoIssues}"
                           FontSize="15" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji"/>
            </Border>

            <!-- Нижние кнопки итогового экрана -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{loc:Loc Sdw.SaveLog}" FontFamily="Segoe UI Emoji"
                        Padding="14,7" Click="OnSaveLog"/>
                <Button Content="{loc:Loc Mods.BtnClose}" Padding="18,7" Margin="8,0,0,0" IsDefault="True" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- Кнопки внизу (живой режим) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Visibility="{Binding IsFinished, Converter={StaticResource InvBoolToVis}}">
            <Button x:Name="CancelBtn" Content="{loc:Loc Sdw.BtnCancel}" FontFamily="Segoe UI Emoji" Padding="14,7"
                    Click="OnCancel" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>