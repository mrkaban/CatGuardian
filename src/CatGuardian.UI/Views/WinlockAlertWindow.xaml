<Window x:Class="CatGuardian.UI.Views.WinlockAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Al2040}" Width="780" Height="660"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.36/3.0.0.48: шаблон алерт-окна семейства (см. EtwAlertWindow-эталон):
         баннер вердикта, секции в карточках, статус действия,
         решающие кнопки одной строкой, утилиты в шапке.
         3.0.0.48+: «Точка входа» — в баннере вердикта (видна без прокрутки);
         секции «Файл» и «Запись» объединены; значения в строках Grid Auto/* — переносятся. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="InlineValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="MaxHeight" Value="56"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ToolTip" Value="Значение можно выделить и скопировать (Ctrl+C). Полный путь доступен во всплывающей подсказке."/>
        </Style>
        <Style x:Key="HeaderUtilityButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + утилиты справа сверху (3.0.0.36). -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}">
                    🛡️ Cat Guardian — попытка блокировки экрана предотвращена
                </TextBlock>
                <TextBlock x:Name="WinlockStatus" Foreground="{DynamicResource RedBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <Button x:Name="BtnWinlockOpenFolder" Style="{StaticResource HeaderUtilityButton}"
                        Content="{loc:Loc Al2041}" Margin="0,0,8,0" Click="OnWinlockOpenFolder"
                        ToolTip="{loc:Loc Al2042}"/>
                <!-- 3.0.0.48: кнопка копирования — как во всех алерт-окнах. -->
                <Button x:Name="BtnWinlockCopy" Style="{StaticResource HeaderUtilityButton}"
                        Content="{loc:Loc Al2043}" Margin="0,0,0,0" Click="OnCopyAll"
                        ToolTip="{loc:Loc Al2044}"/>
            </StackPanel>
        </Grid>

        <!-- Баннер вердикта. 3.0.0.48 (G3): для подмены точки входа здесь же —
             строка «Точка входа», чтобы ключевая информация была видна без прокрутки. -->
        <Border Grid.Row="1" CornerRadius="4" Padding="12,8"
                Background="#1AFFC107" BorderThickness="1"
                BorderBrush="{DynamicResource AmberBrush}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource AmberBrush}">
                    🛡️ ПРЕДОТВРАЩЕНО — элемент блокировщика экрана изолирован
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextBrush}">
                    Блокировщик экрана прячет рабочий стол за фальшивым баннером и требует выкуп. Запись автозагрузки удалена, файл переименован в .bak.
                </TextBlock>
                <TextBlock x:Name="WinlockEntryPoint" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource RedBrush}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <!-- ЧТО СДЕЛАНО -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al2045}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <TextBlock x:Name="ActionFile" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="ActionKill" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="ActionEntry" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ОБЪЕКТ И ЗАПИСЬ (3.0.0.48+: секции «Файл» и «Запись» объединены). -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al2046}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2047}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockFilePath" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2048}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockZone" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2049}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockBranch" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2050}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockEntryName" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- АНАЛИЗ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al2051}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2052}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockSignature" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2053}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockClam" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="WinlockRiskRow" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Al2054}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="WinlockRisk" Grid.Column="1" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Единый статус-блок + решающие кнопки одной строкой (3.0.0.36).
             Статус ВНЕ прокрутки — виден всегда; результат действия пользователя
             выводится во вторую строку блока цветом по исходу. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="StatusBlock" Grid.Row="0" Background="#14FFFFFF" CornerRadius="4"
                    Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource AmberBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                               ToolTip="{loc:Loc Al2055}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnWinlockRestore" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al2056}" Margin="0,0,8,0" Click="OnWinlockRestore"
                        ToolTip="{loc:Loc Al2057}"/>
                <Button x:Name="BtnWinlockKeep" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al2058}" Margin="0,0,8,0" Click="OnWinlockKeep"
                        ToolTip="{loc:Loc Al2059}"/>
                <Button x:Name="BtnWinlockClose" Content="{loc:Loc Al2060}" IsCancel="True"
                        Style="{StaticResource DecisionButton}" Margin="0,0,0,0" Click="OnWinlockClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>