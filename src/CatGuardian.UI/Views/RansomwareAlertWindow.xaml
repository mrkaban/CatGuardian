<Window x:Class="CatGuardian.UI.Views.RansomwareAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Al1724}" Width="780" Height="640"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.36: шаблон алерт-окна семейства (см. EtwAlertWindow-эталон):
         баннер вердикта, секции «КТО → КУДА → АНАЛИЗ», единый статус-блок,
         решающие кнопки одной строкой, утилиты в шапке. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="80"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ToolTip" Value="Значение можно выделить и скопировать (Ctrl+C). Полный путь доступен во всплывающей подсказке."/>
        </Style>
        <Style x:Key="InlineValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="HeaderUtilityButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + утилиты справа сверху (3.0.0.36). -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}">
                    🚨 Cat Guardian — обнаружена активность шифровальщика
                </TextBlock>
                <TextBlock x:Name="ThreatKindText" Foreground="{DynamicResource AmberBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <Button x:Name="BtnOpenFolder" Style="{StaticResource HeaderUtilityButton}"
                        Content="{loc:Loc Al1725}" Click="OnOpenFolder"
                        ToolTip="{loc:Loc Al1726}"/>
                <Button Style="{StaticResource HeaderUtilityButton}" Content="{loc:Loc Al1727}"
                        Margin="0,0,0,0" Click="OnCopyAll"
                        ToolTip="{loc:Loc Al1728}"/>
            </StackPanel>
        </Grid>

        <!-- Баннер вердикта (3.0.0.36). -->
        <Border x:Name="VerdictBorder" Grid.Row="1" CornerRadius="4" Padding="12,8"
                Background="#1AF44336" BorderThickness="1"
                BorderBrush="{DynamicResource RedBrush}">
            <StackPanel>
                <TextBlock x:Name="VerdictTitle" FontSize="14" FontWeight="Bold"
                           TextWrapping="Wrap" Foreground="{DynamicResource RedBrush}"/>
                <TextBlock x:Name="VerdictMeaning" FontSize="12" TextWrapping="Wrap"
                           Margin="0,2,0,0" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <!-- КТО ПЫТАЕТСЯ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1729}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al1730}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProcessNameText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1731}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ProcessPathText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- КУДА НАПРАВЛЕНО -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1732}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al1733}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="FilePathText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="RenameRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1734}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RenameInfoText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- АНАЛИЗ И БЕЗОПАСНОСТЬ -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Al1735}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Al1736}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SignatureText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1737}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="ClamText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 3.0.0.10: репутационная оценка Pre-Scan Heuristics (скрыта, если выключена). -->
                        <StackPanel x:Name="RiskRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1738}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RiskText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="PublisherRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc Al1739}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="PublisherText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="IocLabel" Text="IOC:" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="IocText" Style="{StaticResource InlineValue}"
                                     Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- PID не определён -->
                <Border x:Name="NoPidPanel" Background="#1AF44336" CornerRadius="4" Padding="12,8"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                        ⚠️ Не удалось определить ID процесса. Проверьте вкладку «События» панели для ручного анализа.
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Единый статус-блок + решающие кнопки одной строкой (3.0.0.36). -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="StatusBlock" Grid.Row="0" Background="#14FFFFFF" CornerRadius="4"
                    Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource AmberBrush}"/>
                    <TextBlock x:Name="ActionStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ActionsPanel" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnTrust" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1740}" Margin="0,0,8,0" Click="OnTrust"
                        ToolTip="{loc:Loc Al1741}"/>
                <Button x:Name="BtnCleanup" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1742}" Margin="0,0,8,0" Click="OnCleanup"
                        ToolTip="{loc:Loc Al1743}"/>
                <Button x:Name="BtnKill" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Al1744}" Margin="0,0,8,0" FontWeight="Bold"
                        Background="#D32F2F" Foreground="White" BorderThickness="0" Click="OnKill"
                        ToolTip="{loc:Loc Al1745}"/>
                <Button Content="{loc:Loc Al1746}" IsCancel="True" Style="{StaticResource DecisionButton}"
                        Margin="0,0,0,0" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>