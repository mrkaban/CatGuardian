<Window x:Class="CatGuardian.UI.Views.AmsiAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="Cat Guardian — AMSI" Width="780" Height="640"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.1.5: окно алерта AMSI-инспекции скриптов. Провайдер работает в чужом
         процессе (PowerShell/Office/cscript) и не может показать UI — окно открывает
         панель по алерту службы (AmsiAlert). Кнопка «Доверять этот контент» добавляет
         SHA-256 хэш контента в amsi-trust.txt, после чего повторный запуск не блокируется.
         3.0.1.5-fix: размер и стили приведены к эталонному шаблону семейства алертов
         (LolBinAlertWindow): 780x640, Window.Resources, кнопка «Копировать» в шапке. -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="InlineValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="80"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ToolTip" Value="Значение можно выделить и скопировать (Ctrl+C)."/>
        </Style>
        <Style x:Key="HeaderUtilityButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DecisionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок слева + утилиты справа (как в шаблоне семейства алертов). -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{loc:Loc Ami.Title}"/>
                <TextBlock x:Name="ThreatKindText" Foreground="{DynamicResource RedBrush}"
                           FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{loc:Loc Ami.ThreatKind}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <Button Style="{StaticResource HeaderUtilityButton}" Content="{loc:Loc Al1395}"
                        Margin="0,0,0,0" Click="OnCopyAll"
                        ToolTip="{loc:Loc Al1396}"/>
            </StackPanel>
        </Grid>

        <!-- Баннер вердикта. -->
        <Border Grid.Row="1" CornerRadius="4" Padding="12,8"
                Background="#1AF44336" BorderThickness="1"
                BorderBrush="{DynamicResource RedBrush}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource RedBrush}"
                           Text="{loc:Loc Ami.BannerTitle}"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{loc:Loc Ami.BannerText}"/>
            </StackPanel>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Ami.ProcessSection}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PID:" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="PidText" Style="{StaticResource InlineValue}"
                                 Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc Ami.DetectSection}"/>
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Ami.MarkerLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                        <TextBox x:Name="MarkerText" Style="{StaticResource InlineValue}"/>

                        <TextBlock Text="{loc:Loc Ami.HashLabel}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="0,6,0,0"/>
                        <TextBox x:Name="HashText" Style="{StaticResource InlineValue}"/>

                        <TextBlock Text="{loc:Loc Ami.TimeLabel}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="0,6,0,0"/>
                        <TextBox x:Name="TimeText" Style="{StaticResource InlineValue}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource AmberBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnTrust" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Ami.TrustButton}" MinWidth="190"
                        Margin="0,0,10,0" Click="OnTrustClick"/>
                <Button x:Name="BtnClose" Style="{StaticResource DecisionButton}"
                        Content="{loc:Loc Common.Close}" MinWidth="110" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>