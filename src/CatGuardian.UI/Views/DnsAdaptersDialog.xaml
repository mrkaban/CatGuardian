<Window x:Class="CatGuardian.UI.Views.DnsAdaptersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Dns.AdaptersTitle}"
        Width="580" SizeToContent="Height" MinWidth="500"
        MaxHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel>
            <TextBlock Text="{loc:Loc Dns.AdaptersHeader}" Style="{StaticResource SectionTitleUpper}"/>
            <TextBlock Text="{loc:Loc Dns.AdaptersHint}"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Быстрые действия -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:Loc Dns.SelectAll}" Padding="12,6" Click="OnSelectAll"/>
            <Button Content="{loc:Loc Dns.ClearAll}" Padding="12,6" Margin="8,0,0,0" Click="OnClearAll"/>
        </StackPanel>

        <!-- Список адаптеров -->
        <Border x:Name="AdaptersCard" Grid.Row="2" Style="{StaticResource Card}" Padding="12"
                Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                <StackPanel x:Name="AdaptersList" Margin="4,0,0,0"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="HintText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Padding="26,8"
                    IsDefault="True" Click="OnOk"/>
            <Button Content="{loc:Loc Common.Cancel}" Padding="18,8" Margin="8,0,0,0" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>