<UserControl x:Class="CatGuardian.UI.Views.DnsManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <!-- Модуль «DNS» (3.0.0.19): безопасная настройка серверов DNS активных адаптеров.
         Служба применяет настройки через WMI для IPv4 и IPv6 всех активных адаптеров. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,8,8">

            <!-- Шапка -->
            <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Dns.Header}"/>
            <TextBlock Text="{loc:Loc Dns.Intro}"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <!-- Текущий статус: левый индикатор — защищённый DNS (зелёный),
                 правый — системный DHCP (красный); неактивный индикатор серый. -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DnsProtectionDot" Width="14" Height="14"
                                 Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock x:Name="DnsProtectionText" Text="{loc:Loc Dns.Protected}" FontWeight="Bold"/>
                            <TextBlock x:Name="DnsProtectionHint" Text="{loc:Loc Dns.ProtectedHint}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="28,0,0,0">
                        <Ellipse x:Name="DnsDhcpDot" Width="14" Height="14"
                                 Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock x:Name="DnsDhcpText" Text="{loc:Loc Dns.SystemDhcp}" FontWeight="Bold"/>
                            <TextBlock x:Name="DnsDhcpHint" Text="{loc:Loc Dns.SystemDhcpHint}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Провайдер: Яндекс.DNS -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <RadioButton x:Name="RbProviderYandex" GroupName="DnsProvider" FontFamily="Segoe UI Emoji"
                                 Content="{loc:Loc Dns.ProviderYandex}"
                                 FontWeight="Bold" FontSize="14" Checked="OnProviderChecked"/>
                    <TextBlock Text="{loc:Loc Dns.FilterMode}" Foreground="{DynamicResource MutedBrush}" Margin="24,10,0,0"/>
                    <StackPanel x:Name="ModesYandex" Margin="24,4,0,0">
                        <RadioButton x:Name="RbYandexSafe" GroupName="DnsMode" Content="{loc:Loc Dns.YandexSafe}" Margin="0,3,0,0"/>
                        <RadioButton x:Name="RbYandexFamily" GroupName="DnsMode" Content="{loc:Loc Dns.YandexFamily}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Провайдер: Cloudflare Families -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <RadioButton x:Name="RbProviderCloudflare" GroupName="DnsProvider" FontFamily="Segoe UI Emoji"
                                 Content="{loc:Loc Dns.ProviderCloudflare}" FontWeight="Bold" FontSize="14"
                                 Checked="OnProviderChecked"/>
                    <TextBlock Text="{loc:Loc Dns.FilterMode}" Foreground="{DynamicResource MutedBrush}" Margin="24,10,0,0"/>
                    <StackPanel x:Name="ModesCloudflare" Margin="24,4,0,0">
                        <RadioButton x:Name="RbCfMalware" GroupName="DnsMode" Content="{loc:Loc Dns.CfMalware}" Margin="0,3,0,0"/>
                        <RadioButton x:Name="RbCfFamily" GroupName="DnsMode" Content="{loc:Loc Dns.CfFamily}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Провайдер: AdGuard DNS Public -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <RadioButton x:Name="RbProviderAdguard" GroupName="DnsProvider" FontFamily="Segoe UI Emoji"
                                 Content="{loc:Loc Dns.ProviderAdguard}" FontWeight="Bold" FontSize="14"
                                 Checked="OnProviderChecked"/>
                    <TextBlock Text="{loc:Loc Dns.FilterMode}" Foreground="{DynamicResource MutedBrush}" Margin="24,10,0,0"/>
                    <StackPanel x:Name="ModesAdguard" Margin="24,4,0,0">
                        <RadioButton x:Name="RbAdgDefault" GroupName="DnsMode" Content="{loc:Loc Dns.AdgDefault}" Margin="0,3,0,0"/>
                        <RadioButton x:Name="RbAdgFamily" GroupName="DnsMode" Content="{loc:Loc Dns.AdgFamily}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Действия -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="BtnApplyDns" Content="{loc:Loc Dns.BtnApply}" FontFamily="Segoe UI Emoji"
                        Style="{StaticResource PrimaryButton}" FontSize="14" Padding="18,10"
                        Click="OnApplyDns"/>
                <Button x:Name="BtnResetDns" Content="{loc:Loc Dns.BtnReset}" FontFamily="Segoe UI Emoji"
                        Margin="10,0,0,0" Padding="14,10" Click="OnResetDns"/>
                <Button x:Name="BtnSelectAdapters" Content="{loc:Loc Dns.BtnAdapters}" FontFamily="Segoe UI Emoji"
                        Margin="10,0,0,0" Padding="14,10" Click="OnSelectAdapters"
                        ToolTip="{loc:Loc Dns.BtnAdaptersTooltip}"/>
            </StackPanel>
            <TextBlock x:Name="AdaptersInfo" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                       TextWrapping="Wrap" FontSize="12"/>

            <!-- Результат операции -->
            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                <TextBlock x:Name="DnsActionStatus" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
            </Border>

            <!-- Предупреждение -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontFamily="Segoe UI Emoji"
                           Text="{loc:Loc Dns.AdapterWarning}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>