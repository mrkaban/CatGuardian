<UserControl x:Class="CatGuardian.UI.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CatGuardian.UI.Views"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <DockPanel>
        <TabControl x:Name="MainTabs" DockPanel.Dock="Top" Margin="0,0,0,10" SelectionChanged="OnTabChanged"
                    SelectedIndex="0">
            <TabItem Header="{loc:Loc Fw.TabMonitor}"/>
            <TabItem Header="{loc:Loc Fw.TabRules}"/>
            <TabItem Header="{loc:Loc Fw.TabThreats}"/>
            <!-- Модуль «DNS» (3.0.0.19): безопасная настройка серверов DNS активных адаптеров. -->
            <TabItem Header="{loc:Loc Fw.TabDns}"/>
            <TabItem Header="{loc:Loc Fw.TabLogs}"/>
            <TabItem Header="{loc:Loc Fw.TabSettings}"/>
        </TabControl>

        <Grid>
            <!-- Монитор сети -->
            <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,8,8">
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.TrafficTitle}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Fw.Inbound}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="InSpeed" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Fw.Outbound}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="OutSpeed" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Fw.TotalSent}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="TotalSent" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Fw.TotalRecv}" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="TotalRecv" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.TcpTitle}"
                               Margin="0,20,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc Fw.Search}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="FilterBox" Width="300" Margin="6,0,0,0"
                                 ToolTip="{loc:Loc Fw.SearchTooltip}"/>
                        <Button Content="{loc:Loc Fw.Refresh}" Margin="8,0,0,0" Click="OnRefreshConnections"/>
                        <Button Content="{loc:Loc Fw.Clear}" Margin="8,0,0,0" Click="OnClearConnections"/>
                        <!-- 3.0.0.90: показывать только внешние адреса (скрыть 10.*, 172.16-31.*,
                             192.168.*, loopback, link-local и слушатели без удалённого адреса).
                             Обычный Button в общем стиле темы (ToggleButton шаблоном темы не
                             покрывался и выглядел иначе); состояние переключается в обработчике. -->
                        <Button x:Name="BtnExternalOnly" Content="{loc:Loc Fw.ExternalOnly}" Margin="8,0,0,0"
                                ToolTip="{loc:Loc Fw.ExternalOnlyTooltip}"
                                Click="OnExternalOnlyToggled"/>
                        <TextBlock x:Name="MonitorStatus" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 3.0.0.88: сводка соединений по процессам. Строится из ПОЛНОГО списка
                         подключений (O(N), дешёвая); клик по строке фильтрует основной список
                         ниже по процессу (повторный клик — сброс фильтра). -->
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.ProcessesTitle}"
                               Margin="0,16,0,6"/>
                    <!-- 3.0.0.88-fix: высота ~4 строки + заголовок; остальные процессы — скроллом.
                         3.0.0.90-fix: PreviewMouseWheel — если внутренний скролл исчерпан,
                         колесо листает общий ScrollViewer панели. -->
                    <DataGrid x:Name="ProcessSummaryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              MaxHeight="134" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                              PreviewMouseLeftButtonUp="OnProcessSummaryClick"
                              PreviewMouseWheel="OnMonitorPreviewMouseWheel">
                        <DataGrid.Columns>
                            <!-- 3.0.0.88-fix: DisplayName — placeholder «(нет имени)» только для показа;
                                 в фильтр процесса/поиск идёт реальное ProcessName из модели. -->
                            <DataGridTextColumn Header="{loc:Loc Fw.ColProcess}" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColConns}" Binding="{Binding Connections}" Width="100"/>
                            <DataGridTextColumn Header="LISTEN" Binding="{Binding Listen}" Width="80"/>
                            <DataGridTextColumn Header="ESTABLISHED" Binding="{Binding Established}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 3.0.0.90-fix: PreviewMouseWheel — DataGrid «съедал» колесо своим внутренним
                         ScrollViewer (ExtentHeight==ViewportHeight в StackPanel), и общий скролл
                         монитора не двигался при наведении на таблицу подключений. -->
                    <!-- 3.0.0.96: колонка «Угроза» — соединение с адресом из БД угроз
                         подсвечивается (данные уже заблокированы правилами ThreatIntel). -->
                    <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              MouseDoubleClick="OnConnectionDoubleClick"
                              PreviewMouseWheel="OnMonitorPreviewMouseWheel">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThreat}" Value="True">
                                        <Setter Property="Background" Value="#33D32F2F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColProcess}" Binding="{Binding ProcessName}" Width="160"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColProtocol}" Binding="{Binding Protocol}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColLocalAddr}" Binding="{Binding LocalAddr}" Width="150"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColPort}" Binding="{Binding LocalPort}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColRemoteAddr}" Binding="{Binding RemoteAddr}" Width="150"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColPort}" Binding="{Binding RemotePort}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColState}" Binding="{Binding State}" Width="120"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColThreat}" Binding="{Binding ThreatText}" Width="110"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Правила -->
            <Grid x:Name="RulesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Шапка в ДВЕ строки (3.0.0.90): верхняя — кнопки + направление + поиск
                     (как было до 3.0.0.90; в одну строку не влезает), вторая — фильтры
                     «Действие»/«Протокол». Отдельная строка нужна, чтобы новые ComboBox
                     не вытесняли поле поиска за правый край при узком окне. -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="{loc:Loc Fw.BtnAdd}" Click="OnAddRule"/>
                            <Button Content="{loc:Loc Fw.BtnEdit}" Margin="6,0,0,0" Click="OnEditRule"/>
                            <Button Content="{loc:Loc Fw.BtnDelete}" Margin="6,0,0,0" Click="OnDeleteRule"/>
                            <Button Content="⟳" ToolTip="{loc:Loc Fw.Refresh}" Width="34" Padding="0" Margin="6,0,0,0" Click="OnRefreshRules"/>
                        </StackPanel>
                        <!-- Фильтр по направлению, как в BlocklistFW: все/входящие/исходящие (п.23). -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock Text="{loc:Loc Fw.Show}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbRulesAll" Content="{loc:Loc Fw.All}" GroupName="RuleDirFilter" IsChecked="True"
                                         Margin="6,0,0,0" VerticalAlignment="Center" Checked="OnRuleDirFilterChanged"/>
                            <RadioButton x:Name="RbRulesIn" Content="{loc:Loc Fw.InboundPl}" GroupName="RuleDirFilter"
                                         Margin="6,0,0,0" VerticalAlignment="Center" Checked="OnRuleDirFilterChanged"/>
                            <RadioButton x:Name="RbRulesOut" Content="{loc:Loc Fw.OutboundPl}" GroupName="RuleDirFilter"
                                         Margin="6,0,0,0" VerticalAlignment="Center" Checked="OnRuleDirFilterChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{loc:Loc Fw.Search}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="RulesSearchBox" Width="150" Margin="6,0,0,0"
                                     ToolTip="{loc:Loc Fw.RulesSearchTooltip}"
                                     TextChanged="OnRulesSearchChanged"/>
                        </StackPanel>
                    </Grid>
                    <!-- 3.0.0.90: фильтры по действию и протоколу — пара ComboBox в шапке вкладки. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{loc:Loc Rule.FldAction}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RulesActionFilter" Width="110" Margin="5,0,0,0" SelectedIndex="0"
                                  SelectionChanged="OnRuleDirFilterChanged" ToolTip="{loc:Loc Fw.ActionFilterTooltip}">
                            <ComboBoxItem Content="{loc:Loc Fw.All}"/>
                            <ComboBoxItem Content="{loc:Loc Rule.Allow}"/>
                            <ComboBoxItem Content="{loc:Loc Rule.Block}"/>
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Rule.FldProtocol}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="RulesProtocolFilter" Width="95" Margin="5,0,0,0" SelectedIndex="0"
                                  SelectionChanged="OnRuleDirFilterChanged" ToolTip="{loc:Loc Fw.ProtocolFilterTooltip}">
                            <ComboBoxItem Content="{loc:Loc Rule.Any}"/>
                            <ComboBoxItem Content="TCP"/>
                            <ComboBoxItem Content="UDP"/>
                            <ComboBoxItem Content="ICMP"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <!-- Статус вынесен из панели кнопок на отдельную строку, чтобы длинный текст
                     «Загружено правил: N (входящих: X, исходящих: Y)» не вылезал за экран (п.7). -->
                <!-- 3.0.0.87: колонки «Программа», «Лок. порты», «Удал. порты», «Адреса» —
                     ключевая информация о правиле. Локальные адреса видны в ToolTip адресов. -->
                <!-- 3.0.0.89-fix: явная виртуализация строк — тысячи правил не создают
                     контейнеры все сразу, прокрутка таблицы не тормозит. -->
                <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="OnRulesDoubleClick">
                    <!-- 3.0.0.89-fix: компактная раскладка — «Вкл» первой с коротким заголовком,
                         короткие заголовки портов; сумма фикс. колонок ~710px вместо 840px,
                         поэтому «Имя» (*) получает ~185px вместо 54px. Полный текст Имени/
                         Программы виден в ToolTip (двойной клик открывает редактирование). -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColEnabled}" Binding="{Binding EnabledText}" Width="45">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding EnabledText}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColName}" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColProgram}" Binding="{Binding ProgramText}" Width="110">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{Binding ProgramText}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColAction}" Binding="{Binding ActionText}" Width="85"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColDirection}" Binding="{Binding DirectionText}" Width="95"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColProtocol}" Binding="{Binding ProtocolText}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColLocalPorts}" Binding="{Binding LocalPortsText}" Width="75"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColRemotePorts}" Binding="{Binding RemotePortsText}" Width="75"/>
                        <DataGridTemplateColumn Header="{loc:Loc Fw.ColAddresses}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AddressesText}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding LocalAddressesTooltip}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LocalAddressesTooltip}" Value="">
                                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="RulesStatus" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"/>
            </Grid>

            <!-- Угрозы -->
            <Grid x:Name="ThreatsPanel" Visibility="Collapsed" Margin="0,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Источники угроз -->
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.FeedsTitle}"/>
                    <WrapPanel Margin="0,8,0,4">
                        <Button Content="{loc:Loc Fw.BtnAddSource}" Click="OnAddFeed"/>
                        <Button Content="{loc:Loc Fw.BtnEdit}" Margin="8,0,0,0" Click="OnEditFeed"/>
                        <Button Content="{loc:Loc Fw.BtnDelete}" Margin="8,0,0,0" Click="OnDeleteFeed"/>
                        <Button x:Name="BtnRefreshThreats" Content="{loc:Loc Fw.BtnRefreshThreats}" Margin="8,0,0,0" Click="OnRefreshFeeds"/>
                    </WrapPanel>
                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="6" Padding="10,7" Margin="0,2,0,6">
                        <TextBlock x:Name="ThreatStatus" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                    <DataGrid x:Name="FeedsGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="170"
                              MouseDoubleClick="OnFeedsGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColName}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColSource}" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColFormat}" Binding="{Binding FormatText}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColUpdated}" Binding="{Binding LastUpdateText}" Width="130"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColEnabled}" Binding="{Binding EnabledText}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- IP-адреса из источников (3.0.0.96: домены исключены — только IP/CIDR) -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.IpsTitle}"/>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                        <TextBlock Text="{loc:Loc Fw.Type}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThreatTypeCombo" Width="130" Margin="6,0,0,0"
                                  SelectionChanged="OnThreatFilterChanged"/>
                        <TextBlock Text="{loc:Loc Fw.Source}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <ComboBox x:Name="ThreatFeedCombo" Width="170" Margin="6,0,0,0"
                                  SelectionChanged="OnThreatFilterChanged"/>
                        <TextBlock Text="{loc:Loc Fw.Search}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="ThreatSearchBox" Width="190" Margin="6,0,0,0"
                                 ToolTip="{loc:Loc Fw.ThreatSearchTooltip}"
                                 TextChanged="OnThreatFilterChanged"/>
                        <Button Content="{loc:Loc Fw.ResetFilter}" Margin="8,0,0,0" Click="OnResetThreatFilter"/>
                    </WrapPanel>
                    <!-- 3.0.0.96: мультивыбор + контекстное меню + виртуализация строк
                         (большие фиды — сотни тысяч записей — не тормозят UI). -->
                    <DataGrid x:Name="EntriesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="excluded">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="applied">
                                        <Setter Property="Foreground" Value="#FF3E9B4F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc Fw.MenuCopyIp}" Click="OnCopyThreatIp"/>
                                <MenuItem Header="{loc:Loc Fw.MenuExclude}" Click="OnExcludeThreatIp"/>
                                <MenuItem Header="{loc:Loc Fw.MenuApplySelected}" Click="OnApplySelectedThreats"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColIp}" Binding="{Binding IpDomain}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColType}" Binding="{Binding TypeText}" Width="90"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.Source}" Binding="{Binding FeedName}" Width="*"/>
                            <DataGridTextColumn Header="CIDR" Binding="{Binding Cidr}" Width="140"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColAdded}" Binding="{Binding FirstSeenText}" Width="130"/>
                            <DataGridTextColumn Header="{loc:Loc Fw.ColLastSeen}" Binding="{Binding LastSeenText}" Width="130"/>
                            <!-- 3.0.0.96: метаданные только из самого фида (страна/ASN, если фид их отдаёт). -->
                            <DataGridTextColumn Header="{loc:Loc Fw.ColMeta}" Binding="{Binding MetaText}" Width="160"/>
                            <!-- 3.0.0.18: статус записи — «исключён», если адрес попал в список исключений.
                                 3.0.0.89: + «🟢 применено» / «— нет правила» (факт блокировки в Windows Firewall). -->
                            <DataGridTextColumn Header="{loc:Loc Fw.ColState}" Binding="{Binding StatusText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Действия -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="BtnApplyThreatRules" Content="{loc:Loc Fw.BtnApplyThreats}" Style="{StaticResource PrimaryButton}"
                                    Click="OnApplyThreatRules"/>
                            <!-- 3.0.0.96: синхронизация применённых ThreatIntel:* правил с текущей БД
                                 — удаляет правила с адресами, исчезнувшими из фидов. -->
                            <Button x:Name="BtnSyncThreatRules" Content="{loc:Loc Fw.BtnSyncThreatRules}" Margin="8,0,0,0"
                                    Click="OnSyncThreatRules"/>
                            <Button x:Name="BtnDeleteThreatRules" Content="{loc:Loc Fw.BtnDeleteThreatRules}" Margin="8,0,0,0" Click="OnDeleteThreatRules"/>
                            <Button Content="{loc:Loc Fw.BtnClearDns}" Margin="8,0,0,0" Click="OnClearDnsCache"/>
                        </WrapPanel>
                        <ProgressBar x:Name="ThreatProgress" Height="18" Maximum="100" Margin="0,14,0,0"/>
                        <TextBlock x:Name="ThreatDb" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DNS (3.0.0.19): безопасная настройка серверов DNS. Панель применяет
                 настройки через службу (WMI), поэтому обновляется при открытии вкладки. -->
            <Grid x:Name="DnsPanel" Visibility="Collapsed" Margin="0,0,8,0">
                <views:DnsManagementView x:Name="DnsHost"/>
            </Grid>

            <!-- Логи -->
            <Grid x:Name="LogsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{loc:Loc Fw.BtnRefreshLog}" Click="OnRefreshLogs"/>
                    <TextBlock x:Name="LogsStatus" Margin="14,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <DataGrid x:Name="LogsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColTime}" Binding="{Binding TimeText}" Width="150"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColLevel}" Binding="{Binding Level}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColEvent}" Binding="{Binding Type}" Width="180"/>
                        <DataGridTextColumn Header="{loc:Loc Fw.ColMessage}" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Настройки -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Margin="0,0,8,8">

                    <!-- Исключённые IP-адреса -->
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.ExcludedTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                       Text="{loc:Loc Fw.ExcludedHint}"/>
                            <ListBox x:Name="ExcludedIpsList" Height="150" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="ExcludedIpInput" Width="300" Padding="6,4"
                                         ToolTip="{loc:Loc Fw.ExcludedInputTooltip}"/>
                                <Button Content="{loc:Loc Fw.BtnAdd}" Margin="8,0,0,0" Click="OnAddExcludedIp"/>
                                <Button Content="{loc:Loc Fw.BtnRemoveSelected}" Margin="8,0,0,0" Click="OnRemoveExcludedIp"/>
                                <!-- 3.0.0.18: удаление УЖЕ применённых правил ThreatIntel с исключёнными адресами. -->
                                <Button Content="{loc:Loc Fw.BtnReconcile}" Margin="8,0,0,0" Click="OnReconcileExclusions"
                                        ToolTip="{loc:Loc Fw.ReconcileTooltip}"/>
                            </StackPanel>
                            <TextBlock x:Name="ExclusionsStatus" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Резервные копии -->
                    <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Fw.BackupsTitle}" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="BackupIncludeLogs" Content="{loc:Loc Fw.IncludeLogs}"
                                          IsChecked="True" VerticalAlignment="Center"/>
                                <Button Content="{loc:Loc Fw.BtnBackup}" Style="{StaticResource PrimaryButton}"
                                        Margin="16,0,0,0" Click="OnCreateBackup"/>
                                <Button Content="{loc:Loc Fw.BtnRestore}" Margin="8,0,0,0" Click="OnRestoreBackup"/>
                                <Button Content="{loc:Loc Fw.BtnRefreshList}" Margin="8,0,0,0" Click="OnRefreshBackups"/>
                            </StackPanel>
                            <DataGrid x:Name="BackupsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Margin="0,12,0,0" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Fw.ColFile}" Binding="{Binding File}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Fw.ColSize}" Binding="{Binding Size}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Fw.ColCreated}" Binding="{Binding Created}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="BackupsStatus" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>