<Window x:Class="CatGuardian.UI.Views.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Inspector.EventDetailsTitle}"
        Width="680" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="TimeText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="{loc:Loc Inspector.EventDetailsGroup}" Padding="8"
                  Foreground="{DynamicResource TextBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="13"
                           Foreground="{DynamicResource TextBrush}"/>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenFolderBtn" Content="{loc:Loc Common.OpenFolder}" Padding="14,6"
                    Margin="0,0,8,0" Click="OnOpenFolder" Visibility="Collapsed"/>
            <Button Content="{loc:Loc Common.Close}" Padding="16,6" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>