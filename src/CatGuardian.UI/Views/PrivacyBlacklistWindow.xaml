<Window x:Class="CatGuardian.UI.Views.PrivacyBlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        Title="{loc:Loc Blk.WindowTitle}" Width="720" Height="520"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13">
    <!-- 3.0.0.66 (доработка по живому тесту): ЧЁРНЫЙ СПИСОК Privacy Shield. Окно-стандарт
         семейства (PrivacyShieldAlertWindow/AntiStealerAlertWindow): шапка, список запрещённых
         приложений из конфига PrivacyShieldDeniedApps («[Веб-камера]/[Микрофон] путь»),
         единый статус-блок и кнопки «Убрать» / «Закрыть». «Убрать» отправляет службе
         PrivacyShieldAction(unblock_app) — следующий запрос приложения снова откроет алерт. -->
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"
                       Text="{loc:Loc Blk.HeaderTitle}"/>
            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="{loc:Loc Blk.Hint}"/>
        </StackPanel>

        <!-- Список -->
        <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="4" Padding="4"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox x:Name="AppsList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextBrush}"
                     SelectionChanged="OnSelectionChanged"
                     ToolTip="{loc:Loc Blk.ListTooltip}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Статус-строка -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,8,0,0" Text=""/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnRemove" Style="{StaticResource ActionButton}"
                    Content="{loc:Loc Blk.BtnRemoveShort}" Margin="0,0,8,0"
                    Background="#D32F2F" Foreground="White" BorderThickness="0"
                    Click="OnRemove" IsEnabled="False"
                    ToolTip="{loc:Loc Blk.RemoveBtnTooltip}"/>
            <Button x:Name="BtnClose" Style="{StaticResource ActionButton}"
                    Content="{loc:Loc Blk.BtnCloseWin}" IsCancel="True" Margin="0,0,0,0" Click="OnClose"
                    ToolTip="{loc:Loc Blk.CloseTooltip}"/>
        </StackPanel>
    </Grid>
</Window>