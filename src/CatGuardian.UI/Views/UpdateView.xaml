<UserControl x:Class="CatGuardian.UI.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CatGuardian.UI.Localization">
    <!-- Центр обновлений (3.0.0.99): 4 карточки компонентов (сигнатуры, движок ClamAV,
         IP-списки сетевого экрана, антимайнер) + панель «Обновить всё сразу» с общим
         прогрессом и журналом. Существующие вкладки обновлений не трогаются — логика
         переиспользуется через общие сервисы (FreshClamUpdateManager, ClamAvVersionService,
         ThreatIntelligenceManager, ThreatRuleSyncService, MonitorPipeClient). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,8">

            <!-- Шапка -->
            <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource SectionTitleUpper}" Text="{loc:Loc Upd.Title}"/>
                <TextBlock Text="{loc:Loc Upd.Subtitle}"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ==================== Панель «Обновить всё» ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0"
                    Background="{DynamicResource PanelAltBrush}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Upd.UpdateAll}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{loc:Loc Upd.UpdateAllHint}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="UpdateAllBtn" Content="{loc:Loc Upd.UpdateAll}"
                                FontSize="14" FontWeight="SemiBold" Padding="18,7" Click="OnUpdateAllClick"/>
                        <Button x:Name="CancelBtn" Content="{loc:Loc Upd.Cancel}" Padding="14,6"
                                Margin="8,0,0,0" IsEnabled="False" Click="OnCancelClick"/>
                    </StackPanel>
                    <ProgressBar x:Name="GlobalProgress" Height="8" Margin="0,12,0,0"
                                 Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="GlobalStatus" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc Upd.LogTitle}" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="UpdateLog" IsReadOnly="True" Height="150" FontSize="11"
                             FontFamily="Consolas, Courier New" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource InputBgBrush}"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <!-- ==================== Карточка 1: Сигнатуры угроз ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Upd.SignTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="SignDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SignStatus" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Upd.SignDesc}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SignDetails" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SignCheckBtn" Grid.Column="0" Content="{loc:Loc Upd.Check}"
                                MinWidth="110" Padding="10,4" Click="OnSignCheckClick"/>
                        <Button x:Name="SignUpdBtn" Grid.Column="1" Content="{loc:Loc Upd.Update}"
                                MinWidth="110" Padding="10,4" Margin="8,0,0,0" Click="OnSignUpdateClick"/>
                        <ProgressBar x:Name="SignProgress" Grid.Column="2" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Карточка 2: Движок ClamAV ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Upd.ClamTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="ClamDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ClamStatus" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Upd.ClamDesc}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClamDetails" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ClamCheckBtn" Grid.Column="0" Content="{loc:Loc Upd.Check}"
                                MinWidth="110" Padding="10,4" Click="OnClamCheckClick"/>
                        <Button x:Name="ClamUpdBtn" Grid.Column="1" Content="{loc:Loc Upd.Update}"
                                MinWidth="110" Padding="10,4" Margin="8,0,0,0" Click="OnClamUpdateClick"/>
                        <ProgressBar x:Name="ClamProgress" Grid.Column="2" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Карточка 3: IP-списки сетевого экрана ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Upd.IpTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="IpDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="IpStatus" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Upd.IpDesc}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="IpDetails" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="IpCheckBtn" Grid.Column="0" Content="{loc:Loc Upd.Check}"
                                MinWidth="110" Padding="10,4" Click="OnIpCheckClick"/>
                        <Button x:Name="IpUpdBtn" Grid.Column="1" Content="{loc:Loc Upd.UpdateAndSync}"
                                MinWidth="190" Padding="12,4" Margin="8,0,0,0" Click="OnIpUpdateClick"/>
                        <ProgressBar x:Name="IpProgress" Grid.Column="2" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Карточка 4: Антимайнер ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Upd.MinerTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="MinerDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MinerStatus" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Upd.MinerDesc}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MinerDetails" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MinerCheckBtn" Grid.Column="0" Content="{loc:Loc Upd.Check}"
                                MinWidth="110" Padding="10,4" Click="OnMinerCheckClick"/>
                        <Button x:Name="MinerUpdBtn" Grid.Column="1" Content="{loc:Loc Upd.Update}"
                                MinWidth="110" Padding="10,4" Margin="8,0,0,0" Click="OnMinerUpdateClick"/>
                        <ProgressBar x:Name="MinerProgress" Grid.Column="2" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Карточка 5: Cat Guardian (программа) ==================== -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Upd.ProgramTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="ProgramDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ProgramStatus" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Upd.ProgramDesc}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ProgramDetails" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ProgramCheckBtn" Grid.Column="0" Content="{loc:Loc Upd.Check}"
                                MinWidth="110" Padding="10,4" Click="OnProgramCheckClick"/>
                        <Button x:Name="ProgramUpdBtn" Grid.Column="1" Content="{loc:Loc Upd.ProgramDownload}"
                                MinWidth="190" Padding="12,4" Margin="8,0,0,0" Click="OnProgramUpdateClick"/>
                        <ProgressBar x:Name="ProgramProgress" Grid.Column="2" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>