<Window x:Class="CatGuardian.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CatGuardian.UI.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cat Guardian"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize">
    <!-- Иконка окна/панели задач — простой вариант из версии 2.2 (быстро, без обрезки). -->
    <Window.Icon>
        <BitmapImage UriSource="Resources/app.ico"/>
    </Window.Icon>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel Background="{DynamicResource BgBrush}">
        <!-- Тёмная шапка окна -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Height="46">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="16,0,0,0">
                    <!-- Иконка в шапке — ТА ЖЕ, что иконка окна/панели задач (app.ico), как в 2.2.
                         Лёгкая (36 КБ против 319 КБ у cat_logo.png) и без HighQuality-масштабирования:
                         тяжёлое декодирование PNG на UI-потоке тормозило старт и «съедало»
                         первые клики по трею (#1). -->
                    <Image x:Name="LogoImage" Source="Resources/app.ico"
                           Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    <TextBlock Text="Cat Guardian" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnMin" Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" Click="OnMinimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Tag="min"/>
                    <!-- Максимизация отключена: окно зафиксировано, чтобы блоки нигде не выходили за границы (#15). -->
                    <Button x:Name="BtnMax" Style="{StaticResource TitleBarButton}"
                            Content="&#xE922;" Click="OnMaximizeRestore"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Tag="max"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnClose" Style="{StaticResource TitleBarButton}"
                            Content="&#xE8BB;" Click="OnCloseWindow"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Tag="close"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Навигация слева + контент справа -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая навигация -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,16">
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
                        <TextBlock Text="GNU GPL v2 · Open Source"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavDashboard}" Tag="dashboard" GroupName="nav"
                                     IsChecked="True" Checked="OnNavChanged"/>
                        <!-- 3.0.0.51: антивирус — перед инспектором файлов. -->
                        <RadioButton x:Name="NavAntivirus" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavAntivirus}" Tag="antivirus" GroupName="nav"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavInspector" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavInspector}" Tag="inspector" GroupName="nav"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavFirewall" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavFirewall}" Tag="firewall" GroupName="nav"
                                     Checked="OnNavChanged"/>
                        <!-- 3.0.0.99: общий центр обновлений (сигнатуры, ClamAV, IP-списки, анти-майнер). -->
                        <RadioButton x:Name="NavUpdate" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavUpdate}" Tag="update" GroupName="nav"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavSettings}" Tag="settings" GroupName="nav"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                     Content="{loc:Loc Shell.NavAbout}" Tag="about" GroupName="nav"
                                     Checked="OnNavChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Контент -->
            <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="22,18,22,20"/>
        </Grid>
    </DockPanel>
</Window>