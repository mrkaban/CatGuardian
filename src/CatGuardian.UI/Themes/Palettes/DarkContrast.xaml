<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тема: Тёмная контрастная (высокий контраст, чёрный фон, янтарный акцент) -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="PanelColor">#0A0A0A</Color>
    <Color x:Key="PanelAltColor">#151515</Color>
    <Color x:Key="BorderColor">#4C4C4C</Color>
    <!-- 3.0.0.18: чуть ярче приглушённый текст (контраст против панелей в тёмной теме). -->
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="MutedTextColor">#C2C2C2</Color>
    <Color x:Key="AccentColor">#FFB000</Color>
    <Color x:Key="AccentHoverColor">#FFC94D</Color>
    <Color x:Key="AccentSoftColor">#2A2400</Color>
    <Color x:Key="AccentTextColor">#000000</Color>
    <Color x:Key="GreenColor">#4ADE80</Color>
    <Color x:Key="AmberColor">#FFD166</Color>
    <Color x:Key="RedColor">#FF5555</Color>
    <Color x:Key="SelectionColor">#FFB000</Color>
    <Color x:Key="HeaderColor">#111111</Color>

    <!-- Расширенный набор кистей для полного покрытия всех контролов -->
    <Color x:Key="InputBgColor">#0A0A0A</Color>
    <Color x:Key="HoverBgColor">#1E1E1E</Color>
    <Color x:Key="RowStripeColor">#101010</Color>
    <Color x:Key="ScrollThumbColor">#666666</Color>
    <Color x:Key="ScrollTrackColor">#1A1A1A</Color>
    <Color x:Key="FocusBorderColor">#FFB000</Color>
    <Color x:Key="DangerSoftColor">#3A0D0D</Color>
    <Color x:Key="SuccessSoftColor">#0F2E16</Color>
    <Color x:Key="WarningSoftColor">#33290A</Color>
    <Color x:Key="TabSelectedColor">#0A0A0A</Color>
    <Color x:Key="MenuBgColor">#151515</Color>
    <Color x:Key="DisabledTextColor">#7E7E7E</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>

    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}"/>
    <SolidColorBrush x:Key="RowStripeBrush" Color="{StaticResource RowStripeColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="{StaticResource TabSelectedColor}"/>
    <SolidColorBrush x:Key="MenuBgBrush" Color="{StaticResource MenuBgColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>

</ResourceDictionary>